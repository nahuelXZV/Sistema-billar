@using WebClient.Common
@using WebClient.Models
@using WebClient.Models.Inventory
@model TransaccionInventarioViewModel

@{
	ViewData["Title"] = "Movimientos";
	ViewData["Module"] = "Movimientos";
	ViewData["Action"] = "Listado";
	ViewData["Url"] = Url.Action("Listado", "TransaccionInventario");

	Model.ListaItemsMenu = new List<ItemMenu>
	{
	};
}

@section ActionBar {
	<form id="FormCrear" asp-controller="TransaccionInventario" asp-action="Crear" method="post" class="d-none">
		@Html.AntiForgeryToken()
	</form>

	<div class="iu-tools">
		<div class="iu-tools-actions">
			<button type="submit" form="FormCrear" class="iu-btn iu-btn-primary">
				<i class="bi bi-plus-lg"></i>
				Crear movimiento
			</button>
		</div>
	</div>
}

<section class="iu-show">
	<section class="iu-sec">
		<div id="table-wrapper"></div>
	</section>
</section>
@section Scripts {
	<script>
		new gridjs.Grid({
			columns: ['Id','Producto','Lote','Almacen',
			{
					name: "Tipo",
					formatter: (cell) => {
					  const tipos = {
						1: { text: 'Ingreso', tone: 'tone-primary' },
						2: { text: 'Salida', tone: 'tone-warning' },
						3: { text: 'Merma', tone: 'tone-danger' }
					  };
					  const tipo = tipos[cell] ?? { text: 'N/A', tone: 'tone-warning' };
					  return gridjs.html(`<span class="iu-chip ${tipo.tone}">${tipo.text}</span>`);
					}
			},'Glosa','Transaccion inicial',
			{
			  name: "Fecha",
			  formatter: (cell) => {
				const fecha = new Date(cell);
				return fecha.toLocaleDateString('es-PE', {
					day: '2-digit',
					month: '2-digit',
					year: 'numeric',
					hour: '2-digit',
					minute: '2-digit'
				});
			  }
			}
			,'Cantidad'],
			server: {
			  url: urlWeb + "TransaccionInventario/GetAll",
			  then: data => data.data.map(detalle => [
				detalle.id,detalle.producto.nombre ,detalle.lote?.codigo, detalle.almacen.nombre,
				detalle.transaccionInventario.tipo,detalle.transaccionInventario.glosa, detalle.transaccionInventario.idTransaccionInicial,
				detalle.transaccionInventario.fecha ,detalle.cantidad
			  ]),
			  total: data => data.total
			},
			...this.optionsTable
		}).render(document.getElementById("table-wrapper"));
	</script>
}
