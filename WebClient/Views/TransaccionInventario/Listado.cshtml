@using WebClient.Common
@using WebClient.Models
@using WebClient.Models.Inventory
@model TransaccionInventarioViewModel

@{
	ViewData["Title"] = "Movimientos";
	ViewData["Module"] = "Movimientos";
	ViewData["Action"] = "Listado";

	Model.ListaItemsMenu = new List<ItemMenu>
	{
	};
}

@section ActionBar {
	<div class="card card-outline card-primary action-bar">
		<div class="card-body py-2">
			<div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
				<!-- ZONA IZQUIERDA -->
				<form id="FormCrear" asp-controller="TransaccionInventario" asp-action="Crear" method="post" style="display: none;">
					@Html.AntiForgeryToken()
				</form>
				<div class="action-bar-left d-flex gap-2">
					<button type="submit"
							form="FormCrear"
							class="btn btn-primary btn-sm">
						<i class="bi bi-plus-lg"></i>
						Crear
					</button>
				</div>
				<!-- ZONA DERECHA -->
				<div class="action-bar-right d-flex gap-2">
				</div>
			</div>
		</div>
	</div>
}

<div class="card card-outline card-secondary">
	<div class="card-body p-3">
		<div id="table-wrapper"></div>
	</div>
</div>
@section Scripts {
	<script>
		new gridjs.Grid({
			columns: ['Id','Producto','Lote','Almacen',
			{
					name: "Tipo",
					formatter: (cell) => {
					  const tipos = {
						1: 'Ingreso',
						2: 'Salida',
						3: 'Merma',
					  };
					  const colores = {
						  1: 'primary',
						  2: 'warning',
						  3: 'success',
					  };
					  return gridjs.html(
						`<span class="badge bg-${colores[cell]}">${tipos[cell] ?? 'N/A'}</span>`
					  );
					}
			},'Glosa','Transaccion inicial',
			{
			  name: "Fecha",
			  formatter: (cell) => {
				const fecha = new Date(cell);
				return fecha.toLocaleDateString('es-PE', {
					day: '2-digit',
					month: '2-digit',
					year: 'numeric',
					hour: '2-digit',
					minute: '2-digit'
				});
			  }
			}
			,'Cantidad'],
			server: {
			  url: urlWeb + "TransaccionInventario/GetAll",
			  then: data => data.data.map(detalle => [
				detalle.id,detalle.producto.nombre ,detalle.lote.codigo, detalle.almacen.nombre,
				detalle.transaccionInventario.tipo,detalle.transaccionInventario.glosa, detalle.transaccionInventario.idTransaccionInicial,
				detalle.transaccionInventario.fecha ,detalle.cantidad
			  ]),
			  total: data => data.total
			},
			...this.optionsTable
		}).render(document.getElementById("table-wrapper"));
	</script>
}
