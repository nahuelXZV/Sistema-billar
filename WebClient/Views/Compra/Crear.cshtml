@using WebClient.Components
@using WebClient.Components.Purchases.Compra
@using WebClient.Models.Purchases
@model CompraViewModel

@{
	ViewData["Title"] = "Compras";
	ViewData["Module"] = "Compras";
	ViewData["Action"] = "Registrar compra";
	ViewData["Url"] = Url.Action("Listado", "Compra");
	var componentName = nameof(CompraCrearComponent);
	var componentParameters = new Dictionary<string, object>
	{
		{ nameof(CompraCrearComponent.Compra), Model.Compra },
		{ nameof(CompraCrearComponent.ListaProveedores), Model.ListaProveedores },
		{ nameof(CompraCrearComponent.ListaAlmacenes), Model.ListaAlmacenes },
		{ nameof(CompraCrearComponent.ListaProductos), Model.ListaProductos }
	};
}

<script>
	class @componentName {
		constructor(componentInstance) { this.componentInstance = componentInstance; document.getElementById('btn-save').addEventListener('click', () => this.Validar()); }
		async Validar() { await this.componentInstance.invokeMethodAsync('Validar'); }
		static init(componentInstance) { window.@componentName = new @(componentName)(componentInstance); }
	}
	window.@componentName = @componentName;
</script>

@section ActionBar {
	<div class="iu-tools"><div class="iu-tools-actions">
		<button type="button" class="iu-btn iu-btn-secondary" onclick="history.back()"><i class="bi bi-arrow-left"></i> Volver</button>
		<button id="btn-save" type="button" class="iu-btn iu-btn-primary"><i class="bi bi-floppy"></i> Registrar compra</button>
	</div></div>
}

<section class="iu-show">
	<component type="typeof(MainComponent)" param-ComponentTypeName="typeof(CompraCrearComponent).FullName" param-Parameters="@componentParameters" render-mode="ServerPrerendered" />
</section>
