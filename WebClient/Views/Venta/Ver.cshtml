@using WebClient.Components
@using WebClient.Components.Sales.Venta
@using WebClient.Models.Sales
@model VentaViewModel

@{
	ViewData["Title"] = "Detalle de venta";
	ViewData["Module"] = "Ventas";
	ViewData["Action"] = "Ver venta";
	ViewData["Url"] = Url.Action("Listado", "Venta");

	var componentParameters = new Dictionary<string, object>
	{
		{ nameof(VentaDetalleComponent.Venta), Model.Venta }
	};
}

@section ActionBar {
	<div class="iu-tools">
		<div class="iu-tools-actions">
			<a asp-controller="Venta" asp-action="Listado" class="iu-btn iu-btn-secondary">
				<i class="bi bi-arrow-left"></i>
				Volver al listado
			</a>
		</div>
	</div>
}

<section class="iu-show">
	<component type="typeof(MainComponent)"
			   param-ComponentTypeName="typeof(VentaDetalleComponent).FullName"
			   param-Parameters="@componentParameters"
			   render-mode="ServerPrerendered" />
</section>
