@using WebClient.Common
@using WebClient.Components
@using WebClient.Components.Sales.Vendedor
@using WebClient.Models.Sales
@model VendedorViewModel

@{
	ViewData["Title"] = "Vendedor";
	ViewData["Module"] = "Vendedor";
	ViewData["Action"] = "Crear";
	ViewData["Url"] = Url.Action("Listado", "Vendedor");

	var componentName = nameof(VendedorCreateComponent);
	var componentParameters = new Dictionary<string, object>
	{
		{ nameof(VendedorCreateComponent.Vendedor), Model.Vendedor },
		{ nameof(VendedorCreateComponent.ListaUsuarios), Model.ListaUsuarios },
		{ nameof(VendedorCreateComponent.ListaAlmacenesDisponibles), Model.ListaAlmacenes },
		{ nameof(VendedorCreateComponent.ListaPreciosDisponibles), Model.ListaPrecios }
	};
}
<script>
	class @componentName {
		componentInstance;
		guardarButton;

		constructor(componentInstance) {
			this.componentInstance = componentInstance;
			this.guardarButton = document.getElementById('btn-save');
			this.guardarButton.addEventListener('click', ev => this.Validar());
		}

		async Validar() {
			await this.componentInstance.invokeMethodAsync('Validar');
		}

		static init(componentInstance) {
			window.@componentName = new @(componentName)(componentInstance);
		}
	}

	window.@componentName = @componentName;
</script>

@section ActionBar {
	<div class="iu-tools">
		<div class="iu-tools-actions">
			<button type="button" class="iu-btn iu-btn-secondary" onclick="history.back()">
				<i class="bi bi-arrow-left"></i>
				Volver
			</button>
			<button id="btn-save" type="button" class="iu-btn iu-btn-primary">
				<i class="bi bi-floppy"></i>
				Guardar
			</button>
		</div>
	</div>
}

<section class="iu-show">
	<component type="typeof(MainComponent)"
			   param-ComponentTypeName="typeof(VendedorCreateComponent).FullName"
			   param-Parameters="@componentParameters"
			   render-mode="ServerPrerendered" />
</section>
