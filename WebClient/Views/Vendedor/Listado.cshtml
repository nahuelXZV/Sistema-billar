@using WebClient.Common
@using WebClient.Models
@using WebClient.Models.Sales
@model VendedorViewModel

@{
	ViewData["Title"] = "Vendedor";
	ViewData["Module"] = "Vendedor";
	ViewData["Action"] = "Listado";
	ViewData["Url"] = Url.Action("Listado", "Vendedor");

	Model.ListaItemsMenu = new List<ItemMenu>
	{
		new ItemMenu { Id = MenuItemId.Editar, Text = "Editar", IconCss = "fa fa-pencil", Url = Url.Action("Crear", "Vendedor"), ActionType = MenuItemActionType.POST },
		new ItemMenu { Id = MenuItemId.Eliminar, Text = "Eliminar", IconCss = "fa fa-trash", Url = Url.Action("Eliminar", "Vendedor"), ActionType = MenuItemActionType.POST, Confirm = true, ConfirmMessage = "Esta seguro de eliminar este vendedor?" },
	};
}

@section ActionBar {
	<form id="FormCrear" asp-controller="Vendedor" asp-action="Crear" method="post" class="d-none">
		@Html.AntiForgeryToken()
	</form>

	<div class="iu-tools">
		<div class="iu-tools-actions">
			<button type="submit" form="FormCrear" class="iu-btn iu-btn-primary">
				<i class="bi bi-plus-lg"></i>
				Crear vendedor
			</button>
		</div>
	</div>
}

<section class="iu-show">
	<section class="iu-sec">
		<div id="table-wrapper"></div>
	</section>
</section>

@section Scripts {
	<script>
		const renderSellerActions = (id) => gridjs.html(`
			<button type="button"
					class="inv-btn-action"
					aria-label="Abrir acciones"
					onclick="togglePortalDropdown(event, '${id}')">
				<i class="bi bi-three-dots"></i>
			</button>
		`);

		new gridjs.Grid({
			columns: ['Id', 'Nombre', 'Documento',
				{
					name: 'Activo',
					formatter: (cell) => gridjs.html(`<span class="iu-chip ${cell ? 'tone-success' : 'tone-warning'}">${cell ? 'Activo' : 'Inactivo'}</span>`)
				},
				{
					name: 'Usuario',
					formatter: (cell) => cell ?? "-"
				},
				{
					name: 'Almacenes',
					formatter: (cell) => cell ?? "-"
				},
				{
					name: 'Lista de precios',
					formatter: (cell) => cell ?? "-"
				},
				{
					name: 'Acciones',
					formatter: (cell, row) => renderSellerActions(row._cells[0].data)
				}
			],
			server: {
			  url: urlWeb + "Vendedor/GetAll",
			  then: data => data.data.map(vendedor => [
				vendedor.id,
				vendedor.nombre,
				vendedor.documento,
				vendedor.activo,
				vendedor.usuarioDTO?.username ?? vendedor.usuarioDTO?.nombre ?? null,
				(vendedor.listaAlmacenes ?? []).map(item => item.almacen?.nombre).filter(Boolean).join(', '),
				vendedor.listaPrecioDTO?.nombre ?? null
			  ]),
			  total: data => data.total
			},
			...this.optionsTable
		}).render(document.getElementById("table-wrapper"));
	</script>
}
