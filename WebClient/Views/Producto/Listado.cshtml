@using WebClient.Common
@using WebClient.Models
@using WebClient.Models.Inventory
@model ProductoViewModel

@{
	ViewData["Title"] = "Producto";
	ViewData["Module"] = "Producto";
	ViewData["Action"] = "Listado";
	ViewData["Url"] = Url.Action("Listado", "Producto");

	Model.ListaItemsMenu = new List<ItemMenu>
	{
		new ItemMenu { Id = MenuItemId.Editar, Text = "Editar", IconCss = "fa fa-pencil", Url = Url.Action("Crear", "Producto"), ActionType = MenuItemActionType.POST },
		new ItemMenu { Id = MenuItemId.Eliminar, Text = "Eliminar", IconCss = "fa fa-trash", Url = Url.Action("Eliminar", "Producto"), ActionType = MenuItemActionType.POST, Confirm = true, ConfirmMessage = "Esta seguro de eliminar este producto?" },
	};
}

@section ActionBar {
	<form id="FormCrear" asp-controller="Producto" asp-action="Crear" method="post" class="d-none">
		@Html.AntiForgeryToken()
	</form>

	<div class="iu-tools">
		<div class="iu-tools-actions">
			<button type="submit" form="FormCrear" class="iu-btn iu-btn-primary">
				<i class="bi bi-plus-lg"></i>
				Crear producto
			</button>
		</div>
	</div>
}

<section class="iu-show">
	<section class="iu-sec">
		<div id="table-wrapper"></div>
	</section>
</section>
@section Scripts {
	<script>
		const renderProductActions = (id) => gridjs.html(`
			<button type="button"
					class="inv-btn-action"
					aria-label="Abrir acciones"
					onclick="togglePortalDropdown(event, '${id}')">
				<i class="bi bi-three-dots"></i>
			</button>
		`);

		new gridjs.Grid({
			columns: ['Id',
				{
					name: 'Imagen',
					formatter: (cell) => gridjs.html(`
						<img src="${cell}"
							 alt="Imagen del producto"
							 style="width: 3.5rem; height: 3.5rem; object-fit: cover; border-radius: 0.85rem; border: 1px solid rgba(113, 132, 123, 0.16);">
					`)
				},
				'Nombre', "Descripcion",
				{
					name: "Tipo",
					formatter: (cell) => {
						const tipos = {
							1: { text: 'Producto', tone: 'tone-primary' },
							2: { text: 'Servicio', tone: 'tone-success' }
						};
						const tipo = tipos[cell] ?? { text: 'N/A', tone: 'tone-warning' };
						return gridjs.html(`<span class="iu-chip ${tipo.tone}">${tipo.text}</span>`);
					}
				},
				"Marca",
				"Categoria",
				"Unidad Medida",
				{
					name: 'Acciones',
					formatter: (cell, row) => renderProductActions(row._cells[0].data)
				}
			],
			server: {
			  url: urlWeb + "Producto/GetAll",
			  then: data => data.data.map(producto => [
				producto.id, producto.urlImagen ,producto.nombre, producto.descripcion,producto.tipo , producto.marca,producto.categoria.nombre, producto.unidadMedida.nombre
			  ]),
			  total: data => data.total
			},
			...this.optionsTable
		}).render(document.getElementById("table-wrapper"));
	</script>
}
