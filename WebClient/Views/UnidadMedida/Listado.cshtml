@using WebClient.Common
@using WebClient.Models
@using WebClient.Models.Inventory
@model UnidadMedidaViewModel

@{
	ViewData["Title"] = "Unidad Medida";
	ViewData["Module"] = "Unidad Medida";
	ViewData["Action"] = "Listado";
	ViewData["Url"] = Url.Action("Listado", "UnidadMedida");

	Model.ListaItemsMenu = new List<ItemMenu>
	{
		new ItemMenu { Id = MenuItemId.Editar, Text = "Editar", IconCss = "fa fa-pencil", Url = Url.Action("Crear", "UnidadMedida"), ActionType = MenuItemActionType.POST },
		new ItemMenu { Id = MenuItemId.Eliminar, Text = "Eliminar", IconCss = "fa fa-trash", Url = Url.Action("Eliminar", "UnidadMedida"), ActionType = MenuItemActionType.POST, Confirm = true, ConfirmMessage = "Esta seguro de eliminar esta unidad?" },
	};
}

@section ActionBar {
	<form id="FormCrear" asp-controller="UnidadMedida" asp-action="Crear" method="post" class="d-none">
		@Html.AntiForgeryToken()
	</form>

	<div class="iu-tools">
		<div class="iu-tools-actions">
			<button type="submit" form="FormCrear" class="iu-btn iu-btn-primary">
				<i class="bi bi-plus-lg"></i>
				Crear unidad
			</button>
		</div>
	</div>
}

<section class="iu-show">
	<section class="iu-sec">
		<div id="table-wrapper"></div>
	</section>
</section>
@section Scripts {
	<script>
		const renderUnitActions = (id) => gridjs.html(`
			<button type="button"
					class="inv-btn-action"
					aria-label="Abrir acciones"
					onclick="togglePortalDropdown(event, '${id}')">
				<i class="bi bi-three-dots"></i>
			</button>
		`);

		new gridjs.Grid({
			columns: ['Id', 'Nombre', "Abreviatura",
				{
					name: 'Tipo',
					formatter: (cell) => {
					  const tipos = {
						1: { text: 'Unidad', tone: 'tone-primary' },
						2: { text: 'Peso', tone: 'tone-warning' },
						3: { text: 'Volumen', tone: 'tone-success' },
						4: { text: 'Longitud', tone: 'tone-danger' },
						5: { text: 'Tiempo', tone: 'tone-primary' }
					  };
					  const tipo = tipos[cell] ?? { text: 'N/A', tone: 'tone-warning' };
					  return gridjs.html(`<span class="iu-chip ${tipo.tone}">${tipo.text}</span>`);
					}
				},
				{
					name: 'Acciones',
					formatter: (cell, row) => renderUnitActions(row._cells[0].data)
				}
			],
			server: {
			  url: urlWeb + "UnidadMedida/GetAll",
			  then: data => data.data.map(unidad => [
				unidad.id, unidad.nombre, unidad.abreviatura, unidad.tipo
			  ]),
			  total: data => data.total
			},
			...this.optionsTable
		}).render(document.getElementById("table-wrapper"));
	</script>
}
