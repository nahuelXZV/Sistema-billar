@using WebClient.Common
@using WebClient.Models
@using WebClient.Models.Configuration
@model TipoMesaViewModel

@{
	ViewData["Title"] = "Tipo de mesa";
	ViewData["Module"] = "Tipo de mesa";
	ViewData["Action"] = "Listado";
	ViewData["Url"] = Url.Action("Listado", "TipoMesa");

	Model.ListaItemsMenu = new List<ItemMenu>
	{
		new ItemMenu { Id = MenuItemId.Editar, Text = "Editar", IconCss = "fa fa-pencil", Url = Url.Action("Crear", "TipoMesa"), ActionType = MenuItemActionType.POST },
		new ItemMenu { Id = MenuItemId.Eliminar, Text = "Eliminar", IconCss = "fa fa-trash", Url = Url.Action("Eliminar", "TipoMesa"), ActionType = MenuItemActionType.POST, Confirm = true, ConfirmMessage = "Esta seguro de eliminar este tipo de mesa?" },
	};
}

@section ActionBar {
	<form id="FormCrear" asp-controller="TipoMesa" asp-action="Crear" method="post" class="d-none">
		@Html.AntiForgeryToken()
	</form>

	<div class="iu-tools">
		<div class="iu-tools-actions">
			<button type="submit" form="FormCrear" class="iu-btn iu-btn-primary">
				<i class="bi bi-plus-lg"></i>
				Crear tipo de mesa
			</button>
		</div>
	</div>
}

<section class="iu-show">
	<section class="iu-sec">
		<div id="table-wrapper"></div>
	</section>
</section>
@section Scripts {
	<script>
		const renderTableTypeActions = (id) => gridjs.html(`
			<button type="button"
					class="inv-btn-action"
					aria-label="Abrir acciones"
					onclick="togglePortalDropdown(event, '${id}')">
				<i class="bi bi-three-dots"></i>
			</button>
		`);

		new gridjs.Grid({
			columns: ['Id', 'Nombre',
				{
					name: 'Cobro por tiempo',
					formatter: (cell) => gridjs.html(`<span class="iu-chip ${cell ? 'tone-primary' : 'tone-warning'}">${cell ? 'Por tiempo' : 'Fijo'}</span>`)
				},
				{
					name: 'Acciones',
					formatter: (cell, row) => renderTableTypeActions(row._cells[0].data)
				}
			],
			server: {
			  url: urlWeb + "TipoMesa/GetAll",
			  then: data => data.data.map(almacen => [
				almacen.id, almacen.nombre, almacen.cobroPorTiempo
			  ]),
			  total: data => data.total
			},
			...this.optionsTable
		}).render(document.getElementById("table-wrapper"));
	</script>
}
