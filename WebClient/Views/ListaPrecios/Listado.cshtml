@using WebClient.Common
@using WebClient.Models
@using WebClient.Models.Inventory
@model ListaPreciosViewModel

@{
	ViewData["Title"] = "Lista de precios";
	ViewData["Module"] = "Lista de precios";
	ViewData["Action"] = "Listado";
	ViewData["Url"] = Url.Action("Listado", "ListaPrecios");

	Model.ListaItemsMenu = new List<ItemMenu>
	{
		new ItemMenu { Id = MenuItemId.Editar, Text = "Editar", IconCss = "fa fa-pencil", Url = Url.Action("Crear", "ListaPrecios"), ActionType = MenuItemActionType.POST },
		new ItemMenu { Id = MenuItemId.Eliminar, Text = "Eliminar", IconCss = "fa fa-trash", Url = Url.Action("Eliminar", "ListaPrecios"), ActionType = MenuItemActionType.POST, Confirm = true, ConfirmMessage = "Esta seguro de eliminar esta lista de precios?" },
	};
}

@section ActionBar {
	<form id="FormCrear" asp-controller="ListaPrecios" asp-action="Crear" method="post" class="d-none">
		@Html.AntiForgeryToken()
	</form>

	<div class="iu-tools">
		<div class="iu-tools-actions">
			<button type="submit" form="FormCrear" class="iu-btn iu-btn-primary">
				<i class="bi bi-plus-lg"></i>
				Crear lista
			</button>
		</div>
	</div>
}

<section class="iu-show">
	<section class="iu-sec">
		<div id="table-wrapper"></div>
	</section>
</section>
@section Scripts {
	<script>
		const renderPriceListActions = (id) => gridjs.html(`
			<button type="button"
					class="inv-btn-action"
					aria-label="Abrir acciones"
					onclick="togglePortalDropdown(event, '${id}')">
				<i class="bi bi-three-dots"></i>
			</button>
		`);

		new gridjs.Grid({
			columns: ['Id', 'Nombre', "Descripcion",
				{
					name: "Estado",
					formatter: (cell) => gridjs.html(`<span class="iu-chip ${cell ? 'tone-success' : 'tone-warning'}">${cell ? 'Activo' : 'Inactivo'}</span>`)
				},
				{
					name: 'Acciones',
					formatter: (cell, row) => renderPriceListActions(row._cells[0].data)
				}
			],
			server: {
			  url: urlWeb + "ListaPrecios/GetAll",
			  then: data => data.data.map(producto => [
				producto.id, producto.nombre ,producto.descripcion, producto.activo
			  ]),
			  total: data => data.total
			},
			...this.optionsTable
		}).render(document.getElementById("table-wrapper"));
	</script>
}
