@using WebClient.Models
@model MainViewModel;

@{
	var navModule = ViewData["Module"]?.ToString() ?? "Panel";
	var navAction = ViewData["Action"]?.ToString() ?? "Resumen";
	var navTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
	var navUser = string.IsNullOrWhiteSpace(Model.NombreUsuarioLoggedIn) ? "Usuario" : Model.NombreUsuarioLoggedIn;
	var navFullName = string.IsNullOrWhiteSpace(Model.NombreCompletoUsuarioLoggedIn) ? navUser : Model.NombreCompletoUsuarioLoggedIn;
	var navMail = string.IsNullOrWhiteSpace(Model.CorreoLoggedIn) ? "Sin correo registrado" : Model.CorreoLoggedIn;
}

<nav class="app-header navbar navbar-expand bg-body iu-nav-wrap">
	<div class="container-fluid iu-nav">
		<div class="iu-nav-main">
			<a class="nav-link iu-nav-btn" data-lte-toggle="sidebar" href="#" role="button" aria-label="Abrir menu lateral">
				<i class="bi bi-list"></i>
			</a>

			<div class="iu-nav-copy">
				@* <span class="iu-nav-tag">@navModule</span> *@
				<div class="iu-nav-line">
					<strong>@navTitle</strong>
					<span class="iu-nav-sep"></span>
					<span>@navAction</span>
				</div>
			</div>
		</div>

		<ul class="navbar-nav iu-nav-tools">
			<li class="nav-item">
				<a class="nav-link iu-nav-ico" href="#" data-lte-toggle="fullscreen" aria-label="Pantalla completa">
					<i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
					<i data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display: none"></i>
				</a>
			</li>

			<li class="nav-item dropdown user-menu">
				<a href="#" class="nav-link dropdown-toggle iu-nav-user" data-bs-toggle="dropdown" aria-expanded="false">
					<span class="iu-nav-avatar">
						<i class="bi bi-person-fill iu-nav-avatar-icon" aria-hidden="true"></i>
					</span>
					<span class="iu-nav-user-copy">
						<strong>@navUser</strong>
						@* <small>@navModule</small> *@
					</span>
				</a>

				<ul class="dropdown-menu dropdown-menu-end iu-nav-menu">
					<li class="user-header iu-nav-menu-head">
						<span class="iu-nav-menu-avatar" aria-hidden="true">
							<i class="bi bi-person-fill"></i>
						</span>
						<p>
							@navFullName
							<small>@navMail</small>
						</p>
					</li>
					<li class="user-footer iu-nav-menu-foot">
						<a href="#" class="btn btn-default btn-flat iu-nav-menu-link">Perfil</a>
						<a href="@Url.Action("Cerrar", "Sesion")" class="btn btn-default btn-flat iu-nav-menu-link iu-nav-menu-link--out">Cerrar sesion</a>
					</li>
				</ul>
			</li>
		</ul>
	</div>
</nav>
