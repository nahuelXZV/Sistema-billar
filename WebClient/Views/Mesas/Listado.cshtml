@using WebClient.Common
@using WebClient.Models
@using WebClient.Models.Configuration
@model MesasViewModel

@{
	ViewData["Title"] = "Mesas";
	ViewData["Module"] = "Mesas";
	ViewData["Action"] = "Listado";
	ViewData["Url"] = Url.Action("Listado", "Mesas");

	Model.ListaItemsMenu = new List<ItemMenu>
	{
		new ItemMenu { Id = MenuItemId.Editar, Text = "Editar", IconCss = "fa fa-pencil", Url = Url.Action("Crear", "Mesas"), ActionType = MenuItemActionType.POST },
		new ItemMenu { Id = MenuItemId.Eliminar, Text = "Eliminar", IconCss = "fa fa-trash", Url = Url.Action("Eliminar", "Mesas"), ActionType = MenuItemActionType.POST, Confirm = true, ConfirmMessage = "Esta seguro de eliminar esta mesa?" },
	};
}

@section ActionBar {
	<form id="FormCrear" asp-controller="Mesas" asp-action="Crear" method="post" class="d-none">
		@Html.AntiForgeryToken()
	</form>

	<div class="iu-tools">
		<div class="iu-tools-actions">
			<button type="submit" form="FormCrear" class="iu-btn iu-btn-primary">
				<i class="bi bi-plus-lg"></i>
				Crear mesa
			</button>
		</div>
	</div>
}

<section class="iu-show">
	<section class="iu-sec">
		<div id="table-wrapper"></div>
	</section>
</section>
@section Scripts {
	<script>
		const renderTableActions = (id) => gridjs.html(`
			<button type="button"
					class="inv-btn-action"
					aria-label="Abrir acciones"
					onclick="togglePortalDropdown(event, '${id}')">
				<i class="bi bi-three-dots"></i>
			</button>
		`);

		new gridjs.Grid({
			columns: ['Id', 'Nombre','Tipo Mesa',
				{
					name: 'Activo',
					formatter: (cell) => gridjs.html(`<span class="iu-chip ${cell ? 'tone-success' : 'tone-warning'}">${cell ? 'Activo' : 'Inactivo'}</span>`)
				},
				{
					name: 'Acciones',
					formatter: (cell, row) => renderTableActions(row._cells[0].data)
				}
			],
			server: {
			  url: urlWeb + "Mesas/GetAll",
			  then: data => data.data.map(mesa => [
				mesa.id, mesa.nombre, mesa.tipoMesa.nombre, mesa.activo
			  ]),
			  total: data => data.total
			},
			...this.optionsTable
		}).render(document.getElementById("table-wrapper"));
	</script>
}
