@using Domain.DTOs.Configuration
@using WebClient.Extensions
@using WebClient.Models.Sales
@inherits Components.MainBaseComponent

@if (ProductoTiempo is not null)
{
	<div class="venta-table-timer">
		<div class="venta-table-timer-value">
			<span>Tiempo</span>
			<strong>@TiempoTranscurrido.FormatoTiempo()</strong>
		</div>
		<div class="venta-table-timer-value">
			<span>Tarifa/h</span>
			<strong>@ProductoTiempo.Precio.FormatoDinero()</strong>
		</div>
		<div class="venta-table-timer-value">
			<span>Importe</span>
			<strong>@ImporteTiempoActual.FormatoDinero()</strong>
		</div>

		@if (CronometroPendiente)
		{
			<button type="button"
					class="venta-table-timer-button is-pause"
					disabled="@Iniciando"
					@onclick="IniciarCronometroAsync">
				@if (Iniciando)
				{
					<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
					<span>Iniciando...</span>
				}
				else
				{
					<i class="bi bi-play-fill"></i>
					<span>Iniciar cronómetro</span>
				}
			</button>
		}
		else if (CronometroIniciado)
		{
			<button type="button"
					class="venta-table-timer-button is-finish"
					disabled="@Finalizando"
					@onclick="FinalizarCronometroAsync">
				@if (Finalizando)
				{
					<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
					<span>Finalizando...</span>
				}
				else
				{
					<i class="bi bi-stop-fill"></i>
					<span>Finalizar cronómetro</span>
				}
			</button>
		}
		else
		{
			<span class="venta-table-timer-finished">
				<i class="bi bi-check2-circle"></i>
				Cronómetro finalizado
			</span>
		}
	</div>
}
else if (!string.IsNullOrWhiteSpace(MensajeTemporizador))
{
	<span class="venta-table-timer-finished">@MensajeTemporizador</span>
}
