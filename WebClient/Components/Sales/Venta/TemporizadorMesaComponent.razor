@using Domain.DTOs.Configuration
@using WebClient.Models.Sales
@inherits Components.MainBaseComponent

@if (TimedProduct is not null)
{
	<div class="venta-table-timer">
		<div class="venta-table-timer-value">
			<span>Tiempo</span>
			<strong>@ElapsedTimeText</strong>
		</div>
		<div class="venta-table-timer-value">
			<span>Tarifa/h</span>
			<strong>@FormatMoney(TimedProduct.Precio)</strong>
		</div>
		<div class="venta-table-timer-value">
			<span>Importe</span>
			<strong>@FormatMoney(CurrentTimeAmount)</strong>
		</div>

		@if (!IsTimerFinished)
		{
			<button type="button" class="venta-table-timer-button is-pause" @onclick="ToggleTimer">
				<i class="bi @(IsTimerRunning ? "bi-pause-fill" : "bi-play-fill")"></i>
				<span>@(IsTimerRunning ? "Detener" : "Continuar")</span>
			</button>
			<button type="button" class="venta-table-timer-button is-finish" @onclick="FinishTimerAsync">
				<i class="bi bi-stop-fill"></i>
				<span>Finalizar</span>
			</button>
		}
		else
		{
			<span class="venta-table-timer-finished">
				<i class="bi bi-check2-circle"></i>
				Finalizado
			</span>
		}
	</div>
}
