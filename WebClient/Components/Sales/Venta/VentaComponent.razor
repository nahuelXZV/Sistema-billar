@using WebClient.Models.Sales
@using WebClient.Components.Shared.Elements
@inherits Components.MainBaseComponent;

@if (Model.PuntoVenta is null)
{
	<div class="venta-pos-app venta-pos-loading">
		<div class="venta-pos-skeleton venta-pos-skeleton-topbar"></div>
		<div class="row g-3">
			<div class="col-xl-9">
				<div class="venta-pos-skeleton venta-pos-skeleton-catalog"></div>
			</div>
			<div class="col-xl-3">
				<div class="venta-pos-skeleton venta-pos-skeleton-summary"></div>
			</div>
		</div>
	</div>
}
else
{
	<section class="venta-pos-app">
		<div class="row g-3 align-items-start">
			<div class="col-xl-9">
				<SeleccionarProductoComponent PuntoVenta="Model.PuntoVenta"
											  OnProductoSeleccionado="AgregarItem" />
			</div>

			<div class="col-xl-3">
				<ResumenVentaComponent PuntoVenta="Model.PuntoVenta"
									   OnEliminarItem="EliminarItem"
									   OnIncrementarCantidad="IncrementarCantidad"
									   OnDecrementarCantidad="ReducirCantidad"
									   OnCantidadModificada="SetearCantidad"
									   OnLimpiarVenta="SolicitarLimpiarVenta"
									   MostrarGuardar="EsVentaMesa"
									   Guardando="GuardandoOrden"
									   OnGuardar="GuardarOrdenAsync"
									   OnAbrirPago="MostrarModalPagoHandler" />
			</div>
		</div>

		<ModalPagoComponent PuntoVenta="Model.PuntoVenta"
							BloquearPagoTiempo="BloquearPagoTiempo"
							@bind-Visible="MostrarModalPago"
							OnPaymentConfirmed="PagoConfirmado" />
	</section>

	<IUModal Title="Limpiar venta" @bind-Visible="MostrarConfirmacionLimpiar">
		<Body>
			<div class="venta-table-exit-confirmation is-danger">
				<i class="bi bi-exclamation-octagon"></i>
				<div>
					<strong>¿Quieres limpiar la venta actual?</strong>
					<span>
						Se quitarán todos los productos, el cliente seleccionado, la nota y los ajustes.
						Esta acción no se puede deshacer.
					</span>
				</div>
			</div>
		</Body>
		<Footer>
			<button type="button"
					class="venta-pos-client-modal-button is-secondary"
					@onclick="CancelarLimpiarVenta">
				Conservar venta
			</button>
			<button type="button"
					class="venta-pos-client-modal-button is-danger"
					@onclick="ConfirmarLimpiarVenta">
				<i class="bi bi-trash3"></i>
				Sí, limpiar venta
			</button>
		</Footer>
	</IUModal>
}
