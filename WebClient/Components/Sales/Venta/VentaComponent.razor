@using WebClient.Models.Sales
@inherits Components.MainBaseComponent;

@if (Model.PuntoVenta is null)
{
	<div class="venta-pos-app venta-pos-loading">
		<div class="venta-pos-skeleton venta-pos-skeleton-topbar"></div>
		<div class="row g-3">
			<div class="col-xl-9">
				<div class="venta-pos-skeleton venta-pos-skeleton-catalog"></div>
			</div>
			<div class="col-xl-3">
				<div class="venta-pos-skeleton venta-pos-skeleton-summary"></div>
			</div>
		</div>
	</div>
}
else
{
	<section class="venta-pos-app">
		<div class="row g-3 align-items-start">
			<div class="col-xl-9">
				<SeleccionarProductoComponent PuntoVenta="Model.PuntoVenta"
											  OnProductoSeleccionado="AgregarItem" />
			</div>

			<div class="col-xl-3">
				<ResumenVentaComponent PuntoVenta="Model.PuntoVenta"
									   OnEliminarItem="EliminarItem"
									   OnIncrementarCantidad="IncrementarCantidad"
									   OnDecrementarCantidad="ReducirCantidad"
									   OnCantidadModificada="SetearCantidad"
									   OnLimpiarVenta="LimpiarVenta"
									   OnAbrirPago="MostrarModalPagoHandler" />
			</div>
		</div>

		<ModalPagoComponent PuntoVenta="Model.PuntoVenta"
							@bind-Visible="MostrarModalPago"
							OnPaymentConfirmed="PagoConfirmado" />
	</section>
}
