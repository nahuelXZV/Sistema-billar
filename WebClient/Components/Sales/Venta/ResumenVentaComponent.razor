@using WebClient.Models.Sales

<aside class="venta-pos-summary-panel">
	<div class="venta-pos-summary-header d-flex justify-content-between align-items-center gap-2">
		<div class="venta-pos-summary-title d-flex align-items-center gap-2">
			<div class="venta-pos-summary-icon">
				<i class="bi bi-cart3"></i>
			</div>
			<div class="d-flex flex-column">
				<strong>Venta actual</strong>
				<span>@($"{PuntoVenta.OrderItems.Count} items cargados")</span>
			</div>
		</div>

		<button type="button" class="venta-pos-clear-button" @onclick="ClearSaleAsync">
			<i class="bi bi-arrow-counterclockwise"></i>
			<span>Limpiar</span>
		</button>
	</div>

	<div class="venta-pos-order-list d-flex flex-column m-0 mb-2">
		@foreach (var item in PuntoVenta.OrderItems)
		{
			<article class="venta-pos-order-item">
				<div class="venta-pos-order-content d-flex flex-column">
					<div class="venta-pos-order-head d-flex justify-content-between align-items-center gap-2">
						<strong>@item.Name</strong>
						<button type="button" class="venta-pos-remove-button" @onclick="@(() => RemoveItemAsync(item.ProductId))">
							<i class="bi bi-x-lg"></i>
						</button>
					</div>

					<div class="venta-pos-order-row d-flex justify-content-between align-items-center gap-2">
						<div class="venta-pos-stepper d-flex align-items-center">
							<button type="button" @onclick="@(() => DecreaseQuantityAsync(item.ProductId))">
								<i class="bi bi-dash"></i>
							</button>
							<input type="text"
								   inputmode="decimal"
								   value="@FormatQuantity(item.Quantity)"
								   @onchange="@((args) => SetQuantityAsync(item, ParseQuantity(args.Value)))" />
							<button type="button" @onclick="@(() => IncreaseQuantityAsync(item.ProductId))">
								<i class="bi bi-plus"></i>
							</button>
						</div>

						<strong class="venta-pos-order-price">@FormatMoney(item.Total)</strong>
					</div>
				</div>
			</article>
		}
	</div>

	<div class="venta-pos-totals d-flex flex-column">
		<div class="is-total">
			<span>Total</span>
			<strong>@FormatMoney(PuntoVenta.Subtotal)</strong>
		</div>
	</div>

	<div class="venta-pos-payment-grid d-flex gap-2 mt-2">
		<button type="button"
				class="venta-pos-payment-button is-primary"
				disabled="@(PuntoVenta.OrderItems.Count == 0)"
				@onclick="OpenPaymentAsync">
			<i class="bi bi-cash"></i>
			<span>Pagar</span>
		</button>
	</div>
</aside>
