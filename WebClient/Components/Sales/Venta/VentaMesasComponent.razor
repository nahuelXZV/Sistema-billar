@using Domain.DTOs.Configuration
@using WebClient.Components.Shared.Elements
@using WebClient.Models.Sales
@inherits Components.MainBaseComponent

@if (ModeloVentaSeleccionada is null)
{
	<section class="venta-pos-app venta-tables-app">
		<div class="venta-tables-header">
			<div>
				<span class="venta-pos-kicker">Mesas Disponible</span>
				<h2>Seleccionar mesa</h2>
			</div>

			<div class="venta-tables-actions">
				<button type="button" class="venta-table-direct-button" @onclick="AbrirVentaDirecta">
					<i class="bi bi-cash-register"></i>
					<span>Venta directa</span>
				</button>

				<div class="venta-tables-stats">
					<div>
						<strong>@CantidadMesasActivas</strong>
						<span>Activas</span>
					</div>
					<div>
						<strong>@CantidadMesasInactivas</strong>
						<span>Inactivas</span>
					</div>
				</div>
			</div>
		</div>

		@if (Model.Mesas.Count == 0)
		{
			<div class="venta-tables-empty">
				<i class="bi bi-grid-3x3-gap"></i>
				<strong>No hay mesas registradas</strong>
				<span>Crea mesas desde configuracion para comenzar a vender por mesa.</span>
			</div>
		}
		else
		{
			<div class="venta-tables-grid">
				@foreach (var mesa in Model.Mesas)
				{
					<button type="button"
							class="venta-table-card @ObtenerClaseMesa(mesa)"
							disabled="@(!mesa.Activo)"
							@onclick="@(() => SeleccionarMesaHandler(mesa))">
						<div class="venta-table-card-head">
							<div class="venta-table-icon">
								<i class="bi bi-bounding-box-circles"></i>
							</div>
							<span class="venta-table-status">@ObtenerEstadoMesa(mesa)</span>
						</div>

						<div class="venta-table-copy">
							<strong>@mesa.Nombre</strong>
							<span>@(mesa.TipoMesa?.Nombre ?? "Sin tipo asignado")</span>
						</div>

						<div class="venta-table-card-foot">
							<span>@ObtenerAccionMesa(mesa)</span>
							<i class="bi bi-arrow-right"></i>
						</div>
					</button>
				}
			</div>
		}
	</section>
}
else
{
	<section class="venta-pos-app">
		<nav class="venta-table-sale-nav">
			<button type="button" class="venta-pos-back-button" @onclick="SolicitarVolverAMesas">
				<i class="bi bi-arrow-left"></i>
				<span>Volver a mesas</span>
			</button>

			@if (MesaSeleccionada is not null)
			{
				<TemporizadorMesaComponent Mesa="MesaSeleccionada"
										   Venta="ModeloVentaSeleccionada"
										   OnGuardarOrden="GuardarOrdenMesaAsync"
										   OnOrdenActualizada="OrdenActualizada" />
			}

			<div class="venta-table-sale-title">
				<span>@EtiquetaContextoVenta</span>
				<strong>@TituloContextoVenta</strong>
			</div>
		</nav>

		<VentaComponent Model="ModeloVentaSeleccionada"
						EsVentaMesa="@(MesaSeleccionada is not null)"
						GuardandoOrden="GuardandoOrden"
						OnGuardarOrden="GuardarOrdenMesaAsync"
						OnPrepararPago="PrepararPagoAsync"
						OnVentaFinalizada="VentaFinalizadaAsync" />
	</section>
}

<IUModal Title="Cambios sin guardar" @bind-Visible="MostrarConfirmacionVolver">
	<Body>
		<div class="venta-table-exit-confirmation">
			<i class="bi bi-exclamation-triangle"></i>
			<div>
				<strong>Hay cambios que todavía no fueron guardados.</strong>
				<span>Si vuelves a las mesas ahora, esos cambios se perderán.</span>
			</div>
		</div>
	</Body>
	<Footer>
		<button type="button"
				class="venta-pos-client-modal-button is-secondary"
				@onclick="CancelarVolverAMesas">
			Seguir editando
		</button>
		<button type="button"
				class="venta-pos-client-modal-button is-primary"
				@onclick="ConfirmarVolverAMesas">
			Volver sin guardar
		</button>
	</Footer>
</IUModal>
