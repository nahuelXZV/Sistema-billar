@using WebClient.Components.Shared.Elements
@using WebClient.Extensions
@inherits Components.MainBaseComponent

@if (ModeloVentaSeleccionada is null)
{
	<section class="venta-pos-app venta-tables-app">
		<div class="venta-tables-header">
			<div>
				<span class="venta-pos-kicker">Mesas Disponible</span>
				<h2>Seleccionar mesa</h2>
			</div>

			<div class="venta-tables-actions">
				<button type="button" class="venta-table-direct-button" @onclick="AbrirVentaDirecta">
					<i class="bi bi-cash-register"></i>
					<span>Venta directa</span>
				</button>

				<div class="venta-tables-stats">
					<div>
						<strong>@CantidadMesasActivas</strong>
						<span>Activas</span>
					</div>
					<div>
						<strong>@CantidadMesasInactivas</strong>
						<span>Inactivas</span>
					</div>
				</div>
			</div>
		</div>

		@if (Model.Mesas.Count == 0)
		{
			<div class="venta-tables-empty">
				<i class="bi bi-grid-3x3-gap"></i>
				<strong>No hay mesas registradas</strong>
				<span>Crea mesas desde configuracion para comenzar a vender por mesa.</span>
			</div>
		}
		else
		{
			<div class="venta-tables-grid">
				@foreach (var mesa in Model.Mesas)
				{
					var ordenMesa = ObtenerOrdenMesa(mesa);

					<article class="venta-table-card @ObtenerClaseMesa(mesa)">
						<div class="venta-table-card-head">
							<div class="venta-table-card-identity">
								<div class="venta-table-copy">
									<strong>@mesa.Nombre</strong>
									<span class="venta-table-card-state">
										<i class="bi bi-circle-fill" aria-hidden="true"></i>
										@ObtenerEstadoMesa(mesa)
									</span>
								</div>
							</div>

							@if (ordenMesa is not null)
							{
								<button type="button"
										class="venta-table-delete-order"
										@onclick="@(() => SolicitarEliminarOrden(mesa, ordenMesa))">
									<i class="bi bi-trash3"></i>
									<span>Limpiar mesa</span>
								</button>
							}
						</div>

						@if (ordenMesa is not null)
						{
							<div class="venta-table-order-summary">
								<div>
									<span>Tipo</span>
									<strong>@(mesa.TipoMesa?.Nombre ?? "Sin tipo")</strong>
								</div>
								<div>
									<span>Tiempo</span>
									<strong>@ObtenerTiempoOrden(ordenMesa).FormatoTiempo()</strong>
								</div>
								<div>
									<span>Total actual</span>
									<strong>@ordenMesa.Total.FormatoDinero()</strong>
								</div>
							</div>

							<div class="venta-table-card-actions">
								<button type="button"
										class="venta-table-card-action is-primary"
										@onclick="@(() => SeleccionarMesaHandler(mesa))">
									<i class="bi bi-receipt"></i>
									<span>Continuar orden</span>
								</button>
								<button type="button"
										class="venta-table-card-action is-secondary"
										@onclick="@(() => SolicitarCambiarMesa(mesa, ordenMesa))">
									<i class="bi bi-arrow-left-right"></i>
									<span>Cambiar mesa</span>
								</button>
							</div>
						}
						else
						{
							<div class="venta-table-order-summary is-empty">
								<div>
									<span>Tipo</span>
									<strong>@(mesa.TipoMesa?.Nombre ?? "Sin tipo")</strong>
								</div>
								<div>
									<span>Orden</span>
									<strong>Sin orden</strong>
								</div>
								<div>
									<span>Disponibilidad</span>
									<strong>@(mesa.Activo ? "Lista para usar" : "No disponible")</strong>
								</div>
							</div>

							<div class="venta-table-card-actions is-single">
								<button type="button"
										class="venta-table-card-action @(mesa.Activo ? "is-primary" : "is-secondary")"
										disabled="@(!mesa.Activo)"
										@onclick="@(() => SeleccionarMesaHandler(mesa))">
									<i class="bi @(mesa.Activo ? "bi-plus-circle" : "bi-slash-circle")"></i>
									<span>@ObtenerAccionMesa(mesa)</span>
								</button>
							</div>
						}
					</article>
				}
			</div>
		}
	</section>
}
else
{
	<section class="venta-pos-app">
		<nav class="venta-table-sale-nav">
			<button type="button" class="venta-pos-back-button" @onclick="SolicitarVolverAMesas">
				<i class="bi bi-arrow-left"></i>
				<span>Volver a mesas</span>
			</button>

			@if (MesaSeleccionada is not null)
			{
				<TemporizadorMesaComponent Mesa="MesaSeleccionada"
										   Venta="ModeloVentaSeleccionada"
										   OnGuardarOrden="GuardarOrdenMesaAsync"
										   OnOrdenActualizada="OrdenActualizada" />
			}

			<div class="venta-table-sale-title">
				<span>@EtiquetaContextoVenta</span>
				<strong>@TituloContextoVenta</strong>
			</div>
		</nav>

		<VentaComponent Model="ModeloVentaSeleccionada"
						EsVentaMesa="@(MesaSeleccionada is not null)"
						GuardandoOrden="GuardandoOrden"
						OnGuardarOrden="GuardarOrdenMesaAsync"
						OnPrepararPago="PrepararPagoAsync"
						OnVentaFinalizada="VentaFinalizadaAsync" />
	</section>
}

<IUModal Title="Cambios sin guardar" @bind-Visible="MostrarConfirmacionVolver">
	<Body>
		<div class="venta-table-exit-confirmation">
			<i class="bi bi-exclamation-triangle"></i>
			<div>
				<strong>Hay cambios que todavía no fueron guardados.</strong>
				<span>Si vuelves a las mesas ahora, esos cambios se perderán.</span>
			</div>
		</div>
	</Body>
	<Footer>
		<button type="button"
				class="venta-pos-client-modal-button is-secondary"
				@onclick="CancelarVolverAMesas">
			Seguir editando
		</button>
		<button type="button"
				class="venta-pos-client-modal-button is-primary"
				@onclick="ConfirmarVolverAMesas">
			Volver sin guardar
		</button>
	</Footer>
</IUModal>

<IUModal Title="Cambiar mesa" @bind-Visible="MostrarCambioMesa">
	<Body>
		<div class="venta-table-transfer-modal">
			<div class="venta-table-transfer-copy">
				<strong>Mover @ObtenerNumeroOrden(OrdenAccion) a otra mesa</strong>
				<span>La orden, los productos y el tiempo registrado se mantendrán sin cambios.</span>
			</div>

			<div class="venta-table-transfer-route">
				<span>
					<i class="bi bi-circle-dot"></i>
					@(MesaAccion?.Nombre ?? "Mesa origen")
				</span>
				<i class="bi bi-arrow-right"></i>
				<span>
					<i class="bi bi-geo-alt"></i>
					@NombreMesaDestino
				</span>
			</div>

			<label class="venta-table-transfer-field">
				<span>Mesa de destino</span>
				<select class="venta-table-transfer-select" @bind="IdMesaDestino">
					<option value="0">Selecciona una mesa libre</option>
					@foreach (var mesaDisponible in MesasDisponiblesCambio)
					{
						<option value="@mesaDisponible.Id">@mesaDisponible.Nombre · Libre</option>
					}
				</select>
			</label>

			@if (MesasDisponiblesCambio.Count == 0)
			{
				<div class="venta-table-action-message is-warning">
					<i class="bi bi-exclamation-triangle"></i>
					<span>No existen mesas libres disponibles para realizar el cambio.</span>
				</div>
			}

		</div>
	</Body>
	<Footer>
		<button type="button"
				class="venta-pos-client-modal-button is-secondary"
				disabled="@ProcesandoCambioMesa"
				@onclick="CancelarCambioMesa">
			Cancelar
		</button>
		<button type="button"
				class="venta-pos-client-modal-button is-primary"
				disabled="@(IdMesaDestino <= 0 || ProcesandoCambioMesa)"
				@onclick="ConfirmarCambioMesaAsync">
			@if (ProcesandoCambioMesa)
			{
				<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
				<span>Transfiriendo...</span>
			}
			else
			{
				<i class="bi bi-check2"></i>
				<span>Confirmar cambio</span>
			}
		</button>
	</Footer>
</IUModal>

<IUModal Title="Eliminar orden" @bind-Visible="MostrarEliminarOrden">
	<Body>
		<div class="venta-table-delete-modal">
			<div class="venta-table-exit-confirmation is-danger">
				<i class="bi bi-exclamation-octagon"></i>
				<div>
					<strong>La mesa quedará libre.</strong>
					<span>
						Si @ObtenerNumeroOrden(OrdenAccion) no tiene pagos, se eliminará junto con sus productos y tiempo.
						Si tiene pagos registrados, se conservará como una orden finalizada.
					</span>
				</div>
			</div>

		</div>
	</Body>
	<Footer>
		<button type="button"
				class="venta-pos-client-modal-button is-secondary"
				disabled="@ProcesandoEliminarOrden"
				@onclick="CancelarEliminarOrden">
			Conservar orden
		</button>
		<button type="button"
				class="venta-pos-client-modal-button is-danger"
				disabled="@ProcesandoEliminarOrden"
				@onclick="ConfirmarEliminarOrdenAsync">
			@if (ProcesandoEliminarOrden)
			{
				<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
				<span>Eliminando...</span>
			}
			else
			{
				<i class="bi bi-trash3"></i>
				<span>Sí, eliminar orden</span>
			}
		</button>
	</Footer>
</IUModal>
