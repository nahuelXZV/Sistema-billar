@using WebClient.Components.Shared.Elements
@using WebClient.Models.Sales
@inherits Components.MainBaseComponent;

<IUModal Title="Pagar venta" Visible="Visible" VisibleChanged="HandleVisibleChangedAsync">
	<Body>
		<div class="venta-pos-payment-modal">
			<BuscarClienteComponent PuntoVenta="PuntoVenta" />

			<div class="venta-pos-payment-modal-list">
				@if (PaymentItems.Count == 0)
				{
					<div class="venta-pos-payment-empty">No hay productos pendientes.</div>
				}
				else
				{
					@foreach (var item in PaymentItems)
					{
						<article class="venta-pos-payment-line @(item.IsSelected ? "is-selected" : string.Empty)">
							<label class="venta-pos-payment-check">
								<input type="checkbox" @bind="item.IsSelected" />
								<span>@item.Name</span>
							</label>

							<div class="venta-pos-payment-line-meta">
								<small>@($"{FormatQuantity(item.AvailableQuantity)} disponibles")</small>
								<strong>@FormatMoney(item.UnitPrice)</strong>
							</div>

							<div class="venta-pos-payment-line-actions">
								<div class="venta-pos-stepper d-flex align-items-center">
									<button type="button" @onclick="@(() => DecreasePayQuantity(item))" disabled="@(!item.IsSelected)">
										<i class="bi bi-dash"></i>
									</button>
									<input type="text"
										   inputmode="decimal"
										   value="@FormatQuantity(item.QuantityToPay)"
										   disabled="@(!item.IsSelected)"
										   @onchange="@((args) => SetPayQuantity(item, ParseQuantity(args.Value)))" />
									<button type="button" @onclick="@(() => IncreasePayQuantity(item))" disabled="@(!item.IsSelected)">
										<i class="bi bi-plus"></i>
									</button>
								</div>

								<strong>@FormatMoney(item.Total)</strong>
							</div>
						</article>
					}
				}
			</div>

			<div class="venta-pos-payment-adjustments">
				<button type="button" class="venta-pos-note-link" @onclick="ToggleNote">
					<i class="bi bi-pencil-square"></i>
					@(IsNoteOpen ? "Ocultar nota" : "Agregar nota a la venta")
				</button>

				@if (IsNoteOpen)
				{
					<textarea class="venta-pos-note-textarea"
							  placeholder="Escriba una nota para esta venta..."
							  @bind="PaymentNote"
							  @bind:event="oninput"></textarea>
				}

				<div class="venta-pos-payment-fields">
					<label>
						<span>Descuento</span>
						<div class="venta-pos-money-input">
							<span>Bs</span>
							<input type="number"
								   min="0"
								   step="0.01"
								   @bind-value="DiscountAmount"
								   @bind-value:event="oninput" />
						</div>
					</label>

					<label>
						<span>Recargo</span>
						<div class="venta-pos-money-input">
							<span>Bs</span>
							<input type="number"
								   min="0"
								   step="0.01"
								   @bind-value="ServiceCharge"
								   @bind-value:event="oninput" />
						</div>
					</label>
				</div>
			</div>

			<div class="venta-pos-payment-methods">
				<div class="venta-pos-payment-method-entry">
					<label>
						<span>Metodo de pago</span>
						<select class="venta-pos-payment-method-select"
								@bind="SelectedMetodoPagoId"
								disabled="@(MetodosPago.Count == 0)">
							<option value="0">Seleccione...</option>
							@foreach (var metodo in MetodosPago)
							{
								<option value="@metodo.Id">@metodo.Nombre</option>
							}
						</select>
					</label>

					<label>
						<span>Monto</span>
						<div class="venta-pos-money-input">
							<span>Bs</span>
							<input type="number"
								   min="0"
								   step="0.01"
								   @bind-value="PaymentMethodAmount"
								   @bind-value:event="oninput" />
						</div>
					</label>

					<button type="button"
							class="venta-pos-payment-method-add"
							disabled="@(!CanAddPaymentMethod)"
							@onclick="AddPaymentMethod">
						<i class="bi bi-plus-lg"></i>
						Agregar
					</button>
				</div>

				@if (MetodosPago.Count == 0)
				{
					<div class="venta-pos-payment-empty">No hay metodos de pago activos.</div>
				}
				else if (PaymentMethods.Count == 0)
				{
					<div class="venta-pos-payment-empty">Agrega al menos un metodo de pago.</div>
				}
				else
				{
					<div class="venta-pos-payment-method-summary">
						<div class="venta-pos-payment-method-summary-head">
							<span>Resumen de pagos</span>
							<strong>@FormatMoney(TotalPaid)</strong>
						</div>

						@foreach (var payment in PaymentMethods)
						{
							<div class="venta-pos-payment-method-row">
								<span>
									@if (!string.IsNullOrWhiteSpace(payment.Icono))
									{
										<i class="@payment.Icono"></i>
									}
									@payment.Name
								</span>
								<strong>@FormatMoney(payment.Amount)</strong>
								<button type="button"
										aria-label="Quitar metodo de pago"
										@onclick="@(() => RemovePaymentMethod(payment.Id))">
									<i class="bi bi-x-lg"></i>
								</button>
							</div>
						}
					</div>
				}
			</div>

			<div class="venta-pos-payment-modal-total">
				<span>Total a pagar</span>
				<strong>@FormatMoney(PaymentTotal)</strong>
			</div>

			@if (RemainingAmount > 0)
			{
				<div class="venta-pos-payment-modal-pending">
					<span>Faltante</span>
					<strong>@FormatMoney(RemainingAmount)</strong>
				</div>
			}

			<div class="venta-pos-payment-modal-change">
				<span>Cambio</span>
				<strong>@FormatMoney(ChangeAmount)</strong>
			</div>
		</div>
	</Body>
	<Footer>
		<button type="button" class="venta-pos-client-modal-button is-secondary" @onclick="CloseAsync">
			Cancelar
		</button>
		<button type="button"
				class="venta-pos-client-modal-button is-primary"
				disabled="@(!CanConfirmPayment)"
				@onclick="ConfirmPaymentAsync">
			<i class="bi bi-check2-circle"></i>
			<span>Confirmar pago</span>
		</button>
	</Footer>
</IUModal>
