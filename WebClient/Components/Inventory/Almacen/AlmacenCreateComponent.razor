@using WebClient.Components
@using WebClient.Components.Shared.Elements

@inherits Components.MainBaseComponent;

<EditForm EditContext="_editContext">
	<DataAnnotationsValidator />

	<section class="iu-sec">
		<div class="iu-head">
			<div>
				<h2>@(IsEditing ? "Datos del almacen" : "Nuevo almacen")</h2>
			</div>
		</div>

		<div class="iu-form">
			<div>
				<IUInputText Label="Nombre"
							 Placeholder="Escriba el nombre..."
							 @bind-Value="Almacen.Nombre"
							 Required=true />
				<ValidationMessage For="@(() => Almacen.Nombre)" />
			</div>

			<div>
				<IUTextArea Label="Descripcion"
							Placeholder="Escriba una descripcion..."
							@bind-Value="Almacen.Descripcion" />
				<ValidationMessage For="@(() => Almacen.Descripcion)" />
			</div>
		</div>
	</section>
</EditForm>
