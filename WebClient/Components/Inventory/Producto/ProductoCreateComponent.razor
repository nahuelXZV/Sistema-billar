@using Domain.DTOs.Inventory;
@using Domain.DTOs.Shared;
@using WebClient.Components.Shared.Elements

@inherits Components.MainBaseComponent;

<EditForm EditContext="_editContext">
	<DataAnnotationsValidator />

	<div class="iu-grid iu-grid-2">
		<section class="iu-sec">
			<div class="iu-head">
				<div>
					<h2>@(IsEditing ? "Datos del producto" : "Nuevo producto")</h2>
				</div>
			</div>

			<div class="iu-form">
				<div>
					<label class="form-label fw-semibold">Imagen</label>

					<div class="iu-cat-preview mb-2">
						@if (!string.IsNullOrWhiteSpace(Producto.UrlImagen))
						{
							<img src="@Producto.UrlImagen"
								 class="img-fluid rounded"
								 alt="Imagen producto"
								 onerror="this.style.display='none'" />
						}
						else
						{
							<div class="iu-cat-placeholder">
								<i class="bi bi-image"></i>
								<span>Sin imagen</span>
							</div>
						}
					</div>

				</div>
				<div>
					<IUInputFile Label="Subir imagen"
								 Accept="image/*"
								 HelpText="Seleccione una imagen para guardarla en el servidor."
								 @bind-Value="Producto.UrlImagen" />

					<IUInputText Label="Url Imagen"
								 Placeholder="https://ejemplo.com/imagen.png"
								 @bind-Value="Producto.UrlImagen" />
					<ValidationMessage For="@(() => Producto.UrlImagen)" />
				</div>

				<div class="iu-span-2">
					<IUInputText Label="Nombre"
								 Placeholder="Escriba el nombre..."
								 @bind-Value="Producto.Nombre"
								 Required="true" />
					<ValidationMessage For="@(() => Producto.Nombre)" />
				</div>

				<div class="iu-span-2">
					<IUTextArea Label="Descripcion"
								Placeholder="Escriba una descripcion..."
								@bind-Value="Producto.Descripcion" />
					<ValidationMessage For="@(() => Producto.Descripcion)" />
				</div>

				<div>
					<IUInputText Label="Marca"
								 Placeholder="Escriba la marca..."
								 @bind-Value="Producto.Marca"
								 Required="true" />
					<ValidationMessage For="@(() => Producto.Marca)" />
				</div>

				<div>
					<IUSelectFilterComponent TItem="SelectOptionDTO<short>"
											 TValue="short"
											 Label="Tipo producto"
											 Placeholder="Seleccionar un tipo producto"
											 Options="@ListaTiposProductos"
											 GetText="@(c => c.Label)"
											 GetValue="@(c => c.Value)"
											 @bind-Value="Producto.Tipo" />
					<ValidationMessage For="@(() => Producto.Tipo)" />
				</div>

				<div>
					<IUSelectFilterComponent TItem="CategoriaDTO"
											 TValue="long"
											 Label="Categoria"
											 Placeholder="Selecciona una categoria"
											 Options="@ListadoCategorias"
											 GetText="@(c => c.Nombre)"
											 GetValue="@(c => c.Id)"
											 @bind-Value="Producto.IdCategoria" />
					<ValidationMessage For="@(() => Producto.IdCategoria)" />
				</div>

				<div>
					<IUSelectFilterComponent TItem="UnidadMedidaDTO"
											 TValue="long"
											 Label="Unidad de medida base"
											 Placeholder="Selecciona la unidad base"
											 Options="@ListadoUnidadesMedidas"
											 GetText="@(c => c.Nombre)"
											 GetValue="@(c => c.Id)"
											 @bind-Value="Producto.IdUnidadMedida"
											 @bind-Value:after="SincronizarUnidadBase" />
					<ValidationMessage For="@(() => Producto.IdUnidadMedida)" />
				</div>

				<div class="iu-span-2">
					<div class="iu-row">
						<IUInputCheckbox Label="Activo" @bind-Value="Producto.Activo" />
						<IUInputCheckbox Label="Compuesto" @bind-Value="Producto.EsCompuesto" />
					</div>
				</div>
			</div>
		</section>

		<section class="iu-sec iu-config-card">
			<div class="iu-head">
				<div>
					<h2>Configuración del producto</h2>
				</div>
			</div>

			<div class="iu-config-tabs" role="tablist" aria-label="Configuración del producto">
				<button type="button"
						class="iu-config-tab @(TabConfiguracionActiva == "compuestos" ? "active" : null)"
						role="tab"
						aria-selected="@(TabConfiguracionActiva == "compuestos")"
						@onclick='() => CambiarTabConfiguracion("compuestos")'>
					<i class="bi bi-boxes"></i>
					Producto compuesto
					@if (ListadoProdCompuesto.Count > 0)
					{
						<span class="iu-config-count">@ListadoProdCompuesto.Count</span>
					}
				</button>

				<button type="button"
						class="iu-config-tab @(TabConfiguracionActiva == "unidades" ? "active" : null)"
						role="tab"
						aria-selected="@(TabConfiguracionActiva == "unidades")"
						@onclick='() => CambiarTabConfiguracion("unidades")'>
					<i class="bi bi-rulers"></i>
					Unidades de medida
					@if (ListadoConversiones.Count > 0)
					{
						<span class="iu-config-count">@ListadoConversiones.Count</span>
					}
				</button>
			</div>

			<div class="iu-config-content">
				@if (TabConfiguracionActiva == "compuestos")
				{
					@if (Producto.EsCompuesto)
					{
						<div class="iu-form">
							<div>
								<IUSelectFilterComponent TItem="ProductoDTO"
														 TValue="long"
														 Label="Producto componente"
														 Placeholder="Selecciona un producto"
														 Options="@ListadoProductosDisponibles"
														 GetText="@(c => c.Nombre)"
														 GetValue="@(c => c.Id)"
														 @bind-Value="ProdCompuesto.IdProductoComponente" />
							</div>

							<div>
								<IUInputNumeric TValue="double"
												Label="Cantidad"
												Placeholder="0"
												@bind-Value="ProdCompuesto.Cantidad" />
							</div>

							<div class="iu-span-2">
								<button type="button" class="iu-btn iu-btn-primary" @onclick="AgregarComponente">
									<i class="bi bi-plus-lg"></i>
									Agregar componente
								</button>
							</div>

							<div class="iu-span-2">
								@if (ListadoProdCompuesto.Count > 0)
								{
									<div class="iu-table">
										<table class="inv-table">
											<thead>
												<tr>
													<th>Producto</th>
													<th>Cantidad</th>
													<th>Acciones</th>
												</tr>
											</thead>
											<tbody>
												@foreach (var item in ListadoProdCompuesto)
												{
													<tr>
														<td>@item.ProductoComponente?.Nombre</td>
														<td>@item.Cantidad</td>
														<td>
															<button type="button"
																	class="iu-btn iu-btn-danger"
																	@onclick="() => EliminarComponente(item.IdProductoComponente)">
																<i class="bi bi-trash"></i>
																Eliminar
															</button>
														</td>
													</tr>
												}
											</tbody>
										</table>
									</div>
								}
								else
								{
									<p class="iu-note mb-0">Sin componentes agregados.</p>
								}
							</div>
						</div>
					}
					else
					{
						<div class="iu-config-empty">
							<i class="bi bi-box"></i>
							<p class="iu-note mb-0">
								Activa la opción <strong>Compuesto</strong> para agregar productos componentes.
							</p>
						</div>
					}
				}
				else
				{
					@if (Producto.IdUnidadMedida > 0)
					{
						<div class="iu-form">
							<div>
								<IUSelectFilterComponent TItem="UnidadMedidaDTO"
														 TValue="long"
														 Label="Unidad equivalente"
														 Placeholder="Selecciona una unidad"
														 Options="@ListadoUnidadesConversionDisponibles"
														 GetText="@(unidad => unidad.Nombre)"
														 GetValue="@(unidad => unidad.Id)"
														 @bind-Value="NuevaConversion.IdUnidadMedida" />
							</div>

							<div>
								<IUInputNumeric TValue="decimal"
												Label="Factor hacia la unidad base"
												Placeholder="Ej. 12"
												@bind-Value="NuevaConversion.FactorConversion" />
							</div>

							@if (!string.IsNullOrWhiteSpace(ErrorConversion))
							{
								<div class="iu-span-2">
									<p class="iu-config-error mb-0">@ErrorConversion</p>
								</div>
							}

							<div class="iu-span-2">
								<button type="button" class="iu-btn iu-btn-primary" @onclick="AgregarConversion">
									<i class="bi bi-plus-lg"></i>
									Agregar unidad
								</button>
							</div>

							<div class="iu-span-2">
								<div class="iu-table">
									<table class="inv-table">
										<thead>
											<tr>
												<th>Unidad de medida</th>
												<th>Factor</th>
												<th>Equivalencia</th>
												<th>Acciones</th>
											</tr>
										</thead>
										<tbody>
											@foreach (var item in ListadoConversiones)
											{
												var esUnidadBase = item.IdUnidadMedida == Producto.IdUnidadMedida;
												<tr>
													<td>
														@ObtenerNombreUnidad(item.IdUnidadMedida)
														@if (esUnidadBase)
														{
															<span class="iu-chip tone-primary ms-2">Base</span>
														}
													</td>
													<td>@item.FactorConversion</td>
													<td>
														1 @ObtenerAbreviaturaUnidad(item.IdUnidadMedida)
														= @item.FactorConversion @ObtenerAbreviaturaUnidad(Producto.IdUnidadMedida)
													</td>
													<td>
														@if (!esUnidadBase)
														{
															<button type="button"
																	class="iu-btn iu-btn-danger"
																	@onclick="() => EliminarConversion(item.IdUnidadMedida)">
																<i class="bi bi-trash"></i>
																Eliminar
															</button>
														}
														else
														{
															<span class="iu-note">Obligatoria</span>
														}
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					}
					else
					{
						<div class="iu-config-empty">
							<i class="bi bi-rulers"></i>
							<p class="iu-note mb-0">
								Selecciona primero la unidad de medida base del producto.
							</p>
						</div>
					}
				}
			</div>
		</section>
	</div>
</EditForm>
