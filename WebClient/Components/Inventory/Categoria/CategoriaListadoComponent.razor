@using WebClient.Components
@using WebClient.Components.Shared.Elements

@inherits Components.MainBaseComponent;

<div class="iu-grid">
	<section class="iu-sec">
		<div class="iu-head">
			<div>
				<h2>Categorias</h2>
			</div>
		</div>

		<ul class="tree iu-tree">
			@if (ListaCategorias != null)
			{
				@foreach (var categoria in ListaCategorias)
				{
					<CategoriaTreeComponent Categoria="categoria" OnCategoriaEdit="CategoriaSeleccionado" />
				}
			}
		</ul>
	</section>

	<CategoriaCreateComponent @ref="categoriaCreateComponent"
							  ListaCategorias="ListaCategoriasSinNivel"
							  Categoria="CategoriaSelected"
							  OnCategoriaCreated="Refresh" />
</div>
