@using WebClient.Components.Shared.Elements
@using Domain.DTOs.Inventory;

@inherits Components.MainBaseComponent;

<section class="iu-sec">
	<div class="iu-head">
		<div>
			<h2>@(IsEditing ? "Datos de la categoria" : "Nueva categoria")</h2>
		</div>
	</div>

	<EditForm EditContext="_editContext">
		<DataAnnotationsValidator />

		<div class="iu-form">
			<div>
				<label class="form-label fw-semibold">Imagen</label>

				<div class="iu-cat-preview mb-2">
					@if (!string.IsNullOrWhiteSpace(Categoria.ImagenUrl))
					{
						<img src="@Categoria.ImagenUrl"
							 class="img-fluid rounded"
							 alt="Imagen categoria"
							 onerror="this.style.display='none'" />
					}
					else
					{
						<div class="iu-cat-placeholder">
							<i class="bi bi-image"></i>
							<span>Sin imagen</span>
						</div>
					}
				</div>

				<IUInputText Label="Url Imagen"
							 Placeholder="https://ejemplo.com/imagen.png"
							 @bind-Value="Categoria.ImagenUrl" />
				<ValidationMessage For="@(() => Categoria.ImagenUrl)" />
			</div>

			<div>
				<IUInputText Label="Nombre"
							 Placeholder="Escriba el nombre..."
							 @bind-Value="Categoria.Nombre"
							 Required="true" />
				<ValidationMessage For="@(() => Categoria.Nombre)" />
			</div>

			<div>
				<IUInputNumeric Label="Orden visual"
								Placeholder="0"
								@bind-Value="Categoria.OrdenVisual"
								Required="true" />
			</div>

			<div>
				<IUSelectFilterComponent TItem="CategoriaDTO"
										 TValue="long?"
										 Label="Categoria Padre"
										 Placeholder="Selecciona una categoria"
										 Options="@ListaCategorias"
										 GetText="@(c => c.Nombre)"
										 GetValue="@(c => c.Id)"
										 @bind-Value="Categoria.IdCategoriaPadre" />
			</div>

			<div class="iu-span-2">
				<IUTextArea Label="Descripcion"
							Placeholder="Escriba una descripcion..."
							@bind-Value="Categoria.Descripcion" />
				<ValidationMessage For="@(() => Categoria.Descripcion)" />
			</div>

			<div class="iu-span-2 d-flex justify-content-between align-items-center flex-wrap gap-3">
				<IUInputCheckbox Label="Activo" @bind-Value="Categoria.Activo" />

				<div class="d-flex flex-wrap gap-2">
					@if (Categoria.Id != 0)
					{
						<button type="button" class="iu-btn iu-btn-danger" @onclick="Eliminar">
							<i class="bi bi-trash-fill"></i>
							Eliminar
						</button>
					}

					<button type="button" class="iu-btn iu-btn-primary" @onclick="Validar">
						<i class="bi bi-floppy-fill"></i>
						Guardar
					</button>
				</div>
			</div>
		</div>
	</EditForm>
</section>
