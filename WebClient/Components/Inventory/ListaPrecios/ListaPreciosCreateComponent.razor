@using Domain.DTOs.Security;
@using WebClient.Components
@using WebClient.Components.Shared.Elements
@using Domain.DTOs.Inventory;

@inherits Components.MainBaseComponent;

<div class="d-flex flex-column flex-md-row gap-1">
	<IUCard CustomClass="col-12 col-md-4">
		<Header>
			<h3>Datos de la lista de precios</h3>
		</Header>
		<Body>
			<EditForm EditContext="_editContext">
				<DataAnnotationsValidator />
				<div class="row">
					<div class="col-12">
						<IUInputText Label="Nombre"
									 Placeholder="Escriba el nombre del perfil..."
									 @bind-Value="ListaPrecio.Nombre"
									 Required=true />
						<ValidationMessage For=@(() => ListaPrecio.Nombre) />
					</div>
					<div class="col-12">
						<IUTextArea Label="Descripcion"
									Placeholder="Escriba una pequeña descripcion..."
									@bind-Value="ListaPrecio.Descripcion"
									Required=true />
						<ValidationMessage For=@(() => ListaPrecio.Descripcion) />
					</div>
					<div class="col-12 col-md-6 ">
						<label class="d-none d-md-block invisible mb-2">Activo</label>
						<IUInputCheckbox Label="Activo" @bind-Value="ListaPrecio.Activo" />
					</div>
				</div>
			</EditForm>
		</Body>
	</IUCard>

	<IUCard CustomClass="col-12 col-md-8">
		<Header>
			<h3 class="">Listado de productos</h3>
		</Header>
		<Body>
			<div class="row">
				<div class="col-12 col-md-7">
					<IUSelectFilterComponent TItem="ProductoDTO"
											 TValue="long"
											 Label="Producto"
											 Placeholder="Selecciona un producto"
											 Options="@ListadoProductos"
											 GetText="@(c => c.Nombre)"
											 GetValue="@(c => c.Id)"
											 @bind-Value="DetalleDTO.IdProducto" />
				</div>
				<div class="col-12 col-md-3">
					<div class="mb-3">
						<label class="form-label">Precio</label>
						<input type="number"
							   class="form-control"
							   placeholder="0.0"
							   @bind-value="DetalleDTO.Precio" />
					</div>
				</div>

				<div class="col-12 col-md-2">
					<label class="d-none d-md-block invisible mb-2">Agregar</label>
					<IUButton IconCss="bi bi-plus-lg"
							  Text="Agregar"
							  OnClick="AgregarDetalle" />
				</div>
			</div>
			<div class="row px-2">
				@if (ListadoDetalles.Count > 0)
				{
					<table class="inv-table">
						<thead>
							<tr>
								<th>Producto</th>
								<th>Precio</th>
								<th>Acciones</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in DetallesPaginados)
							{
								<tr>
									<td>@item.NombreProducto</td>
									<td style="width:150px;">@item.Precio Bs.</td>
									<td style="width:150px;">
										<button class="btn btn-primary btn-sm" @onclick="() => EditarDetalle(item.IdProducto)">
											<i class="bi bi-pencil"></i>
										</button>
										<button class="btn btn-danger btn-sm" @onclick="() => EliminarDetalle(item.IdProducto)">
											<i class="bi bi-trash"></i>
										</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
					<div class="d-flex justify-content-between mt-3">
						<span>
							Página @PaginaActual de @TotalPaginas
						</span>
						<div>
							<button class="btn btn-outline-secondary btn-sm me-2"
									@onclick="PaginaAnterior"
									disabled="@(PaginaActual == 1)">
								Anterior
							</button>
							<button class="btn btn-outline-secondary btn-sm"
									@onclick="PaginaSiguiente"
									disabled="@(PaginaActual == TotalPaginas)">
								Siguiente
							</button>
						</div>

					</div>
				}
				else
				{
					<p class="mt-3">No se asociaron productos.</p>
				}
			</div>
		</Body>
	</IUCard>
</div>
