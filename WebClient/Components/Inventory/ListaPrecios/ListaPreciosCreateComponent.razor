@using Domain.DTOs.Inventory;
@using WebClient.Components.Shared.Elements

@inherits Components.MainBaseComponent;

<EditForm EditContext="_editContext">
	<DataAnnotationsValidator />

	<div class="iu-grid iu-grid-2">
		<section class="iu-sec">
			<div class="iu-head">
				<div>
					<h2>@(IsEditing ? "Datos de la lista de precios" : "Nueva lista de precios")</h2>
				</div>
			</div>

			<div class="iu-form">
				<div class="iu-span-2">
					<IUInputText Label="Nombre"
								 Placeholder="Escriba el nombre..."
								 @bind-Value="ListaPrecio.Nombre"
								 Required="true" />
					<ValidationMessage For="@(() => ListaPrecio.Nombre)" />
				</div>

				<div class="iu-span-2">
					<IUTextArea Label="Descripcion"
								Placeholder="Escriba una pequena descripcion..."
								@bind-Value="ListaPrecio.Descripcion"
								Required="true" />
					<ValidationMessage For="@(() => ListaPrecio.Descripcion)" />
				</div>

				<div class="iu-span-2">
					<IUInputCheckbox Label="Activo" @bind-Value="ListaPrecio.Activo" />
				</div>
			</div>
		</section>

		<section class="iu-sec">
			<div class="iu-head">
				<div>
					<h2>Productos</h2>
				</div>
			</div>

			<div class="iu-form">
				<div>
					<IUSelectFilterComponent TItem="ProductoDTO"
											 TValue="long"
											 Label="Producto"
											 Placeholder="Selecciona un producto"
											 Options="@ListadoProductos"
											 GetText="@(c => c.Nombre)"
											 GetValue="@(c => c.Id)"
											 @bind-Value="IdProductoSeleccionado"
											 @bind-Value:after="ProductoSeleccionado" />
				</div>

				<div>
					<IUSelectFilterComponent TItem="ProductoConversionDTO"
											 TValue="long"
											 Label="Unidad de medida"
											 Placeholder="Selecciona una unidad"
											 Options="@ConversionesProductoSeleccionado"
											 GetText="ObtenerEtiquetaConversion"
											 GetValue="@(conversion => conversion.Id)"
											 Disabled="@(IdProductoSeleccionado == 0)"
											 @bind-Value="DetalleDTO.IdProductoConversion" />
				</div>

				<div>
					<IUInputNumeric TValue="decimal"
									Label="Precio"
									Placeholder="0.0"
									@bind-Value="DetalleDTO.Precio" />
				</div>

				<div class="d-flex align-items-end mb-3">
					<button type="button" class="iu-btn iu-btn-primary" @onclick="AgregarDetalle">
						<i class="bi @(IdProductoConversionEnEdicion.HasValue ? "bi-check-lg" : "bi-plus-lg")"></i>
						@(IdProductoConversionEnEdicion.HasValue ? "Actualizar precio" : "Agregar precio")
					</button>
				</div>

				<div class="iu-span-2">
					@if (ListadoDetalles.Count > 0)
					{
						<div class="iu-table">
							<table class="inv-table">
								<thead>
									<tr>
										<th>Producto</th>
										<th>Unidad</th>
										<th>Factor</th>
										<th>Precio</th>
										<th>Acciones</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var item in DetallesPaginados)
									{
										<tr>
											<td>@item.NombreProducto</td>
											<td>@item.NombreUnidadMedida</td>
											<td>
												@if (item.FactorConversion == 1)
												{
													<span class="iu-chip tone-primary">Base</span>
												}
												else
												{
													<span>x @item.FactorConversion</span>
												}
											</td>
											<td>@item.Precio Bs.</td>
											<td>
												<div class="d-flex flex-wrap gap-2">
													<button type="button" class="iu-btn iu-btn-secondary" @onclick="() => EditarDetalle(item.IdProductoConversion)">
														<i class="bi bi-pencil"></i>
														Editar
													</button>
													<button type="button" class="iu-btn iu-btn-danger" @onclick="() => EliminarDetalle(item.IdProductoConversion)">
														<i class="bi bi-trash"></i>
														Eliminar
													</button>
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>

						<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
							<span class="iu-note">Pagina @PaginaActual de @TotalPaginas</span>
							<div class="d-flex gap-2">
								<button type="button"
										class="iu-btn iu-btn-secondary"
										@onclick="PaginaAnterior"
										disabled="@(PaginaActual == 1)">
									Anterior
								</button>
								<button type="button"
										class="iu-btn iu-btn-secondary"
										@onclick="PaginaSiguiente"
										disabled="@(PaginaActual == TotalPaginas)">
									Siguiente
								</button>
							</div>
						</div>
					}
					else
					{
						<p class="iu-note mb-0">Sin productos asociados.</p>
					}
				</div>
			</div>
		</section>
	</div>
</EditForm>
