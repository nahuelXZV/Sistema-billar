@using Domain.DTOs.Shared;
@using WebClient.Components.Shared.Elements

@inherits Components.MainBaseComponent;

<section class="iu-sec">
	<div class="iu-head">
		<div>
			<h2>@(IsEditing ? "Datos de la unidad" : "Nueva unidad")</h2>
		</div>
	</div>

	<EditForm EditContext="_editContext">
		<DataAnnotationsValidator />

		<div class="iu-form">
			<div>
				<IUInputText Label="Nombre"
							 Placeholder="Escriba el nombre..."
							 @bind-Value="Unidad.Nombre"
							 Required="true" />
				<ValidationMessage For="@(() => Unidad.Nombre)" />
			</div>

			<div>
				<IUInputText Label="Abreviatura"
							 Placeholder="Escribe una abreviatura"
							 @bind-Value="Unidad.Abreviatura"
							 Required="true" />
				<ValidationMessage For="@(() => Unidad.Abreviatura)" />
			</div>

			<div>
				<IUSelect TItem="SelectOptionDTO<int>"
						  TValue="int"
						  Label="Tipo"
						  Placeholder="Seleccionar un tipo"
						  Options="@ListaUnidades"
						  GetText="@(c => c.Label)"
						  GetValue="@(c => c.Value)"
						  @bind-Value="Unidad.Tipo"
						  Required="true" />
				<ValidationMessage For="@(() => Unidad.Tipo)" />
			</div>
		</div>
	</EditForm>
</section>
