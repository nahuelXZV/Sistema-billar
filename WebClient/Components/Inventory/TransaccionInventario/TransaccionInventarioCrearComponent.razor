@using Domain.DTOs.Inventory;
@using Domain.DTOs.Shared;
@using WebClient.Components.Inventory.Lote
@using WebClient.Components.Shared.Elements

@inherits Components.MainBaseComponent;

<EditForm EditContext="_editContext">
	<DataAnnotationsValidator />

	<div class="iu-grid iu-grid-2">
		<section class="iu-sec">
			<div class="iu-head">
				<div>
					<h2>@(IsEditing ? "Datos del movimiento" : "Nuevo movimiento")</h2>
				</div>
			</div>

			<div class="iu-form">
				<div>
					<IUInputDatetime Label="Fecha"
									 @bind-Value="TransaccionInventario.Fecha"
									 Required="true" />
					<ValidationMessage For="@(() => TransaccionInventario.Fecha)" />
				</div>

				<div>
					<IUSelect TItem="SelectOptionDTO<short>"
							  TValue="short"
							  Label="Tipo movimiento"
							  Placeholder="Selecciona un movimiento"
							  Options="@ListadoTipos"
							  GetText="@(c => c.Label)"
							  GetValue="@(c => c.Value)"
							  @bind-Value="TransaccionInventario.Tipo" />
					<ValidationMessage For="@(() => TransaccionInventario.Tipo)" />
				</div>

				<div class="iu-span-2">
					<IUTextArea Label="Glosa"
								Placeholder="Escribe una descripcion..."
								@bind-Value="TransaccionInventario.Glosa" />
					<ValidationMessage For="@(() => TransaccionInventario.Glosa)" />
				</div>
			</div>
		</section>

		<section class="iu-sec">
			<div class="iu-head">
				<div>
					<h2>Detalle productos</h2>
				</div>
			</div>

			<div class="iu-form">
				<div>
					<IUSelectFilterComponent TItem="ProductoDTO"
											 TValue="long?"
											 Label="Producto"
											 Placeholder="Selecciona un producto"
											 Options="@ListadoProductos"
											 GetText="@(c => c.Nombre)"
											 GetValue="@(c => (long?)c.Id)"
											 Value="@DetalleDTO.IdProducto"
											 ValueChanged="ProductoCambiado" />
				</div>

				<div>
					<IUSelectFilterComponent TItem="ProductoConversionDTO"
											 TValue="long?"
											 Label="Unidad de medida"
											 Placeholder="Selecciona una unidad"
											 Options="@ListadoUnidadesDisponibles"
											 GetText="DescripcionUnidad"
											 GetValue="@(c => (long?)c.Id)"
											 Value="@DetalleDTO.IdProductoConversion"
											 ValueChanged="UnidadCambiada"
											 Disabled="@(DetalleDTO.IdProducto <= 0)"
											 Required="true" />
				</div>

				<div>
					<IUSelectFilterComponent TItem="LoteDTO"
											 TValue="long?"
											 Label="Lote"
											 Placeholder="Selecciona un lote"
											 Options="@ListadoLotesDisponibles"
											 GetText="@(c => c.Codigo)"
											 GetValue="@(c => c.Id)"
											 @bind-Value="DetalleDTO.IdLote" />
				</div>

				<div>
					<IUSelectFilterComponent TItem="AlmacenDTO"
											 TValue="long"
											 Label="Almacen"
											 Placeholder="Selecciona un almacen"
											 Options="@ListadoAlmacenes"
											 GetText="@(c => c.Nombre)"
											 GetValue="@(c => c.Id)"
											 @bind-Value="DetalleDTO.IdAlmacen" />
				</div>

				<div>
					<IUInputNumeric TValue="double"
									Label="Cantidad"
									Placeholder="0"
									@bind-Value="DetalleDTO.Cantidad" />
				</div>

				<div class="iu-span-2 d-flex flex-wrap gap-2">
					<button type="button" class="iu-btn iu-btn-secondary" @onclick="AbrirModalCrearLote">
						<i class="bi bi-box-seam"></i>
						Nuevo lote
					</button>

					<button type="button" class="iu-btn iu-btn-primary" @onclick="AgregarProducto">
						<i class="bi bi-plus-lg"></i>
						Agregar
					</button>
				</div>

				<div class="iu-span-2">
					@if (ListadoDetalles.Count > 0)
					{
						<div class="iu-table">
							<table class="inv-table">
								<thead>
									<tr>
										<th>Producto</th>
										<th>Unidad</th>
										<th>Almacen</th>
										<th>Lote</th>
										<th>Cantidad</th>
										<th>Equivalente base</th>
										<th>Acciones</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var item in ListadoDetalles)
									{
										<tr>
											<td>@item.NombreProducto</td>
											<td>@item.NombreUnidadMedida</td>
											<td>@item.NombreAlmacen</td>
											<td>@item.CodigoLote</td>
											<td>@item.Cantidad</td>
											<td>@($"{CantidadBase(item):0.######} {UnidadBase(item)}")</td>
											<td>
												<div class="d-flex flex-wrap gap-2">
													<button type="button" class="iu-btn iu-btn-secondary" @onclick="() => Editar(item.IdProducto, item.IdProductoConversion, item.IdLote, item.IdAlmacen)">
														<i class="bi bi-pencil"></i>
														Editar
													</button>
													<button type="button" class="iu-btn iu-btn-danger" @onclick="() => EliminarDetalle(item.IdProducto, item.IdProductoConversion, item.IdLote, item.IdAlmacen)">
														<i class="bi bi-trash"></i>
														Eliminar
													</button>
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
					else
					{
						<p class="iu-note mb-0">Sin productos agregados.</p>
					}
				</div>
			</div>
		</section>
	</div>
</EditForm>

<IUModal Title="Nuevo lote" @bind-Visible="MostrarModalLote">
	<Body>
		<LoteCreateComponent @ref="ModalCrearLoteComponent" OnLoteCreated="prop => LoteCreado(prop)" IdProducto="DetalleDTO.IdProducto" />
	</Body>
	<Footer>
		<button type="button" class="iu-btn iu-btn-secondary" @onclick="CerrarModalCrearLote">
			<i class="bi bi-x-circle"></i>
			Cancelar
		</button>
		<button type="button" class="iu-btn iu-btn-primary" @onclick="GuardarLote">
			<i class="bi bi-floppy"></i>
			Guardar
		</button>
	</Footer>
</IUModal>
