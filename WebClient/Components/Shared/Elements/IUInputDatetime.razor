<div class="mb-3">
	<label for="@Id" class="form-label">
		@Label
		@if (Required)
		{
			<span class="text-danger">*</span>
		}
	</label>

	<input type="@InputType"
		   id="@Id"
		   class="@InputClass"
		   value="@FormatValue(Value)"
		   @onchange="OnChange"
		   required="@Required"
		   readonly="@Readonly" />
</div>

@code {
	[Parameter] public string Label { get; set; } = "Label";
	[Parameter] public string Id { get; set; } = Guid.NewGuid().ToString();
	[Parameter] public string InputClass { get; set; } = "form-control";

	[Parameter] public bool Required { get; set; }
	[Parameter] public bool Readonly { get; set; }

	[Parameter]
	public bool IncluirHora { get; set; } = false;

	[Parameter] public DateTime? Value { get; set; }
	[Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }

	private string InputType => IncluirHora ? "datetime-local" : "date";

	private string? FormatValue(DateTime? value)
	{
		if (!value.HasValue)
			return null;

		return IncluirHora
			? value.Value.ToString("yyyy-MM-ddTHH:mm")
			: value.Value.ToString("yyyy-MM-dd");
	}

	private async Task OnChange(ChangeEventArgs e)
	{
		var texto = e.Value?.ToString();

		var formatos = IncluirHora
			? new[] { "yyyy-MM-ddTHH:mm", "yyyy-MM-ddTHH:mm:ss" }
			: new[] { "yyyy-MM-dd" };

		if (DateTime.TryParseExact(
				texto,
				formatos,
				System.Globalization.CultureInfo.InvariantCulture,
				System.Globalization.DateTimeStyles.None,
				out var newValue))
		{
			await ValueChanged.InvokeAsync(newValue);
		}
		else
		{
			await ValueChanged.InvokeAsync(null);
		}
	}
}