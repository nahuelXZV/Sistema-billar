@using Domain.DTOs.Contact;
@using WebClient.Components.Shared.Elements

@inherits Components.MainBaseComponent;

<section class="iu-sec">
	<div class="iu-head">
		<div>
			<h2>@(IsEditing ? "Datos del cliente" : "Nuevo cliente")</h2>
		</div>
	</div>

	<EditForm EditContext="_editContext">
		<DataAnnotationsValidator />

		<div class="iu-form">
			<div>
				<IUInputText Label="Nombre"
							 Placeholder="Escriba el nombre..."
							 @bind-Value="Cliente.Nombre"
							 Required="true" />
				<ValidationMessage For="@(() => Cliente.Nombre)" />
			</div>

			<div>
				<IUInputText Label="Documento"
							 Placeholder="Escriba el documento..."
							 @bind-Value="Cliente.Documento"
							 Required="true" />
				<ValidationMessage For="@(() => Cliente.Documento)" />
			</div>

			<div>
				<IUInputText Label="Telefono"
							 Placeholder="Escriba el telefono..."
							 @bind-Value="Cliente.Telefono" />
				<ValidationMessage For="@(() => Cliente.Telefono)" />
			</div>
		</div>
	</EditForm>
</section>
