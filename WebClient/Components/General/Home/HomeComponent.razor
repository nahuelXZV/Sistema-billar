@using Domain.DTOs.General
@inherits Components.MainBaseComponent

@if (IsLoading)
{
	<div class="iu-show home-dashboard-loading">
		<div class="home-skeleton hero"></div>
		<div class="home-skeleton-row">
			<div class="home-skeleton card"></div>
			<div class="home-skeleton card"></div>
			<div class="home-skeleton card"></div>
			<div class="home-skeleton card"></div>
		</div>
	</div>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
	<section class="iu-show">
		<div class="iu-sec home-dashboard-error">
			<i class="bi bi-exclamation-circle"></i>
			<div>
				<strong>No se pudo cargar el dashboard</strong>
				<span>@ErrorMessage</span>
			</div>
		</div>
	</section>
}
else if (Dashboard is not null)
{
	<section class="iu-show home-dashboard">
		<section class="iu-sec home-dashboard-header">
			<div>
				<span class="iu-kicker">Analitica del negocio</span>
				<h1>Rendimiento general</h1>
				<p>Compara ventas, consumo de productos y uso de mesas en los periodos recientes.</p>
			</div>
			<div class="home-dashboard-updated">
				<i class="bi bi-arrow-repeat"></i>
				<span>Actualizado @Dashboard.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")</span>
			</div>
		</section>

		<div class="iu-grid-4">
			<article class="iu-sec home-kpi-card">
				<div class="home-kpi-icon tone-success">
					<i class="bi bi-cash-coin"></i>
				</div>
				<div class="home-kpi-content">
					<span>Ventas del mes</span>
					<strong>@FormatCurrency(Dashboard.VentasMesActual)</strong>
					<small>Facturacion acumulada del mes actual</small>
				</div>
			</article>

			<article class="iu-sec home-kpi-card">
				<div class="home-kpi-icon tone-primary">
					<i class="bi bi-graph-up-arrow"></i>
				</div>
				<div class="home-kpi-content">
					<span>Ventas en 12 meses</span>
					<strong>@FormatCurrency(Dashboard.VentasUltimosDoceMeses)</strong>
					<small>@Dashboard.CantidadVentasUltimosDoceMeses operaciones registradas</small>
				</div>
			</article>

			<article class="iu-sec home-kpi-card">
				<div class="home-kpi-icon tone-warning">
					<i class="bi bi-clock-history"></i>
				</div>
				<div class="home-kpi-content">
					<span>Horas de mesa</span>
					<strong>@Dashboard.HorasMesaUltimosDoceMeses.ToString("N1")</strong>
					<small>Tiempo consumido en los ultimos 12 meses</small>
				</div>
			</article>

			<article class="iu-sec home-kpi-card">
				<div class="home-kpi-icon tone-danger">
					<i class="bi bi-box-seam"></i>
				</div>
				<div class="home-kpi-content">
					<span>Unidades vendidas</span>
					<strong>@Dashboard.UnidadesVendidasUltimosDoceMeses.ToString("N0")</strong>
					<small>Productos vendidos en los ultimos 12 meses</small>
				</div>
			</article>
		</div>

		<div class="home-chart-grid">
			<section class="iu-sec home-chart-card">
				<div class="iu-head">
					<div>
						<span class="iu-kicker">Demanda de sala</span>
						<h2>Mesas mas usadas</h2>
					</div>
					<span class="home-chart-period">Ultimos 12 meses</span>
				</div>

				@if (Dashboard.MesasMasUsadas.Count > 0)
				{
					<div class="home-chart">
						<ApexChart TItem="DashboardChartItemDTO">
							<ApexPointSeries TItem="DashboardChartItemDTO"
											 Items="Dashboard.MesasMasUsadas"
											 Name="Usos"
											 SeriesType="SeriesType.Bar"
											 XValue="item => item.Etiqueta"
											 YValue="item => item.Valor" />
						</ApexChart>
					</div>
				}
				else
				{
					<DashboardEmptyState Message="Aun no hay usos de mesa registrados en este periodo." />
				}
			</section>

			<section class="iu-sec home-chart-card">
				<div class="iu-head">
					<div>
						<span class="iu-kicker">Preferencias de consumo</span>
						<h2>Productos mas vendidos</h2>
					</div>
					<span class="home-chart-period">Top 7</span>
				</div>

				@if (Dashboard.ProductosMasVendidos.Count > 0)
				{
					<div class="home-chart">
						<ApexChart TItem="DashboardChartItemDTO">
							<ApexPointSeries TItem="DashboardChartItemDTO"
											 Items="Dashboard.ProductosMasVendidos"
											 Name="Unidades"
											 SeriesType="SeriesType.Donut"
											 XValue="item => item.Etiqueta"
											 YValue="item => item.Valor" />
						</ApexChart>
					</div>
				}
				else
				{
					<DashboardEmptyState Message="Aun no hay productos vendidos en este periodo." />
				}
			</section>

			<section class="iu-sec home-chart-card">
				<div class="iu-head">
					<div>
						<span class="iu-kicker">Tendencia anual</span>
						<h2>Ventas por mes</h2>
					</div>
					<span class="home-chart-period">12 meses</span>
				</div>

				<div class="home-chart">
					<ApexChart TItem="DashboardChartItemDTO">
						<ApexPointSeries TItem="DashboardChartItemDTO"
										 Items="Dashboard.VentasPorMes"
										 Name="Ventas"
										 SeriesType="SeriesType.Area"
										 XValue="item => item.Etiqueta"
										 YValue="item => item.Valor" />
					</ApexChart>
				</div>
			</section>

			<section class="iu-sec home-chart-card">
				<div class="iu-head">
					<div>
						<span class="iu-kicker">Ritmo reciente</span>
						<h2>Ventas por semana</h2>
					</div>
					<span class="home-chart-period">8 semanas</span>
				</div>

				<div class="home-chart">
					<ApexChart TItem="DashboardChartItemDTO">
						<ApexPointSeries TItem="DashboardChartItemDTO"
										 Items="Dashboard.VentasPorSemana"
										 Name="Ventas"
										 SeriesType="SeriesType.Line"
										 XValue="item => item.Etiqueta"
										 YValue="item => item.Valor" />
					</ApexChart>
				</div>
			</section>
		</div>

		<section class="iu-sec">
			<div class="iu-head">
				<div>
					<span class="iu-kicker">Acciones rapidas</span>
					<h2>Gestion operativa</h2>
				</div>
			</div>

			<div class="iu-grid-4">
				<a class="iu-sec home-quick-action" href="/Venta/VentaMesas">
					<div class="home-quick-action-icon tone-primary">
						<i class="bi bi-grid-3x3-gap-fill"></i>
					</div>
					<div class="home-quick-action-copy">
						<strong>Abrir mesa</strong>
						<span>Iniciar consumo y controlar tiempo de juego.</span>
					</div>
					<i class="bi bi-arrow-up-right"></i>
				</a>

				<a class="iu-sec home-quick-action" href="/Venta/VentaDirecta">
					<div class="home-quick-action-icon tone-success">
						<i class="bi bi-cart-check"></i>
					</div>
					<div class="home-quick-action-copy">
						<strong>Venta directa</strong>
						<span>Registrar una venta sin asignarla a una mesa.</span>
					</div>
					<i class="bi bi-arrow-up-right"></i>
				</a>

				<a class="iu-sec home-quick-action" href="/Producto/Listado">
					<div class="home-quick-action-icon tone-warning">
						<i class="bi bi-cup-straw"></i>
					</div>
					<div class="home-quick-action-copy">
						<strong>Productos</strong>
						<span>Gestionar bebidas, snacks y servicios.</span>
					</div>
					<i class="bi bi-arrow-up-right"></i>
				</a>

				<a class="iu-sec home-quick-action" href="/TransaccionInventario/Crear">
					<div class="home-quick-action-icon tone-danger">
						<i class="bi bi-arrow-left-right"></i>
					</div>
					<div class="home-quick-action-copy">
						<strong>Movimiento de stock</strong>
						<span>Registrar entradas y salidas de inventario.</span>
					</div>
					<i class="bi bi-arrow-up-right"></i>
				</a>
			</div>
		</section>
	</section>
}
