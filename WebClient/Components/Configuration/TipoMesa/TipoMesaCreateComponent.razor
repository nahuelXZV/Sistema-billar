@using Domain.DTOs.Inventory;
@using WebClient.Components.Shared.Elements

@inherits Components.MainBaseComponent;

<section class="iu-sec">
	<div class="iu-head">
		<div>
			<h2>@(IsEditing ? "Datos del tipo de mesa" : "Nuevo tipo de mesa")</h2>
		</div>
	</div>

	<EditForm EditContext="_editContext">
		<DataAnnotationsValidator />

		<div class="iu-form">
			<div>
				<IUInputText Label="Nombre"
							 Placeholder="Escriba el nombre..."
							 @bind-Value="TipoMesa.Nombre"
							 Required="true" />
				<ValidationMessage For="@(() => TipoMesa.Nombre)" />
			</div>

			<div>
				<IUSelectFilterComponent TItem="ProductoDTO"
										 TValue="long?"
										 Label="Producto"
										 Placeholder="Selecciona un producto"
										 Options="@ListaProductos"
										 GetText="@(c => c.Nombre)"
										 GetValue="@(c => c.Id)"
										 @bind-Value="TipoMesa.IdProducto" />
			</div>

			<div>
				<IUInputCheckbox Label="Cobra por tiempo" @bind-Value="TipoMesa.CobroPorTiempo" />
			</div>
		</div>
	</EditForm>
</section>
