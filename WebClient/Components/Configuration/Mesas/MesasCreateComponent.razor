@using Domain.DTOs.Configuration;
@using WebClient.Components.Shared.Elements

@inherits Components.MainBaseComponent;

<section class="iu-sec">
	<div class="iu-head">
		<div>
			<h2>@(IsEditing ? "Datos de la mesa" : "Nueva mesa")</h2>
		</div>
	</div>

	<EditForm EditContext="_editContext">
		<DataAnnotationsValidator />

		<div class="iu-form">
			<div>
				<IUInputText Label="Nombre"
							 Placeholder="Escriba el nombre..."
							 @bind-Value="Mesa.Nombre"
							 Required="true" />
				<ValidationMessage For="@(() => Mesa.Nombre)" />
			</div>

			<div>
				<IUSelectFilterComponent TItem="TipoMesaDTO"
										 TValue="long"
										 Label="Tipo de mesa"
										 Placeholder="Selecciona un tipo de mesa"
										 Options="@ListaTipoMesas"
										 GetText="@(c => c.Nombre)"
										 GetValue="@(c => c.Id)"
										 @bind-Value="Mesa.IdTipoMesa" />
			</div>

			<div>
				<IUInputCheckbox Label="Activo" @bind-Value="Mesa.Activo" />
			</div>
		</div>
	</EditForm>
</section>
