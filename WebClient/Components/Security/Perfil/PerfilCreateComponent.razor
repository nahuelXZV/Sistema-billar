@using WebClient.Components
@using WebClient.Components.Shared.Elements
@inherits Components.MainBaseComponent;

<EditForm EditContext="_editContext">
	<DataAnnotationsValidator />

	<div class="iu-grid">
		<section class="iu-sec">
			<div class="iu-head">
				<div>
					<h2>@(IsEditing ? "Datos del perfil" : "Nuevo perfil")</h2>
				</div>
			</div>

			<div class="iu-form">
				<div class="iu-span-2">
					<IUInputText Label="Nombre"
								 Placeholder="Escriba el nombre del perfil..."
								 @bind-Value="Perfil.Nombre"
								 Required=true />
					<ValidationMessage For="@(() => Perfil.Nombre)" />
				</div>

				<div class="iu-span-2">
					<IUTextArea Label="Descripcion"
								Placeholder="Escriba una pequena descripcion..."
								@bind-Value="Perfil.Descripcion"
								Required=true />
					<ValidationMessage For="@(() => Perfil.Descripcion)" />
				</div>
			</div>
		</section>

		<section class="iu-sec">
			<div class="iu-head">
				<div>
					<h2>Accesos</h2>
				</div>
				<span class="iu-chip">
					<i class="bi bi-sliders2"></i>
					@SelectedAccessesLabel
				</span>
			</div>

			@if (ModulesWithAccess.Count == 0)
			{
				<p class="iu-note mb-0">No hay accesos disponibles para configurar.</p>
			}
			else
			{
				<div class="iu-surf">
					@foreach (var modulo in ModulesWithAccess)
					{
						<section class="iu-box">
							<h4>@modulo.Nombre</h4>

							<div class="iu-list mt-3">
								@foreach (var acceso in modulo.ListaAccesos)
								{
									var isChecked = ListaAccesosSeleccionados.Contains(acceso.Id);
									<div class="iu-check">
										<IUInputCheckbox Label="@acceso.Nombre"
														 Value="@isChecked"
														 ValueChanged="@(value => OnAccesoSeleccionChanged(acceso.Id, value))" />
									</div>
								}
							</div>
						</section>
					}
				</div>
			}
		</section>
	</div>
</EditForm>
