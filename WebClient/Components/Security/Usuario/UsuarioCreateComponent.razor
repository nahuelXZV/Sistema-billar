@using Domain.DTOs.Security;
@using WebClient.Components
@using WebClient.Components.Shared.Elements

@inherits Components.MainBaseComponent;

<EditForm EditContext="_editContext">
	<DataAnnotationsValidator />
	<div class="iu-show">
		<section class="iu-sec">
			<div class="iu-grid-2">
				<div>
					<IUInputText Label="Nombre"
								 Placeholder="Escriba el nombre..."
								 @bind-Value="Usuario.Nombre"
								 Required=true />
					<ValidationMessage For="@(() => Usuario.Nombre)" />
				</div>

				<div>
					<IUInputText Label="Apellido"
								 Placeholder="Escriba el apellido..."
								 @bind-Value="Usuario.Apellido"
								 Required=true />
					<ValidationMessage For="@(() => Usuario.Apellido)" />
				</div>

				<div>
					<IUInputText Label="Username"
								 Placeholder="Escriba el username..."
								 @bind-Value="Usuario.Username"
								 Required=true />
					<ValidationMessage For="@(() => Usuario.Username)" />
				</div>

				<div>
					<IUInputText Label="Correo"
								 Placeholder="Escriba el correo..."
								 @bind-Value="Usuario.Email"
								 Required=true />
					<ValidationMessage For="@(() => Usuario.Email)" />
				</div>

				<div>
					<IUSelect TItem="PerfilDTO"
							  TValue="long"
							  Label="Perfil"
							  Placeholder="Escoge un perfil"
							  Options="@ListaPerfiles"
							  GetText="@(c => c.Nombre)"
							  GetValue="@(c => c.Id)"
							  @bind-Value="Usuario.PerfilId"
							  Required="true" />
					<ValidationMessage For="@(() => Usuario.PerfilId)" />
				</div>

				@if (ShowPasswordField)
				{
					<div>
						<IUInputPassword Label="Contrasena"
										 Placeholder="Escriba la contrasena..."
										 @bind-Value="Usuario.Password"
										 Required=true />
						<ValidationMessage For="@(() => Usuario.Password)" />
					</div>
				}

				@if (IsEditing)
				{
					<div class="iu-span-2">
						<div class="iu-checks">
							<div class="iu-check">
								<IUInputCheckbox Label="Usuario activo" @bind-Value="Usuario.Activo" />
								<p>Permite el acceso normal al sistema y mantiene visible la cuenta para operaciones diarias.</p>
							</div>

							<div class="iu-check">
								<IUInputCheckbox Label="Modificar contrasena" @bind-Value="ModificarContrasena" />
								<p>Activa el campo de clave solo cuando sea necesario cambiar las credenciales del usuario.</p>
							</div>
						</div>
					</div>
				}
			</div>
		</section>
	</div>
</EditForm>
